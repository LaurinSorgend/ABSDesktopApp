// Controls in the shape of the current style.

import { Theme } from "theme.slint";
import { FocusRing } from "focus.slint";
import { Sheen } from "glass.slint";
import { CloseIcon } from "icons.slint";

export { Segmented, SeekBar, Dropdown } from "pickers.slint";

/// The darker bottom edge WinUI draws under its controls.
component BottomEdge inherits Rectangle {
    height: 1px;
    background: Theme.stroke;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    min-width: max(Theme.material ? 72px : 88px, label.preferred-width + (Theme.pill ? 32px : 24px));
    min-height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.corner(self.height);
    background: !enabled ? Theme.control
        : primary ? (touch.pressed ? Theme.action.mix(Theme.on-action, 0.8) : touch.has-hover ? Theme.action.mix(Theme.on-action, 0.9) : Theme.action)
        : (touch.pressed ? Theme.control-press : touch.has-hover ? Theme.control-hover : Theme.control);
    border-width: primary && enabled && !Theme.catppuccin ? 0px : Theme.border;
    border-color: primary && enabled ? Theme.action : touch.has-hover && Theme.catppuccin ? Theme.overlay2 : Theme.rim;
    animate background, border-color { duration: Theme.quick; easing: ease-out; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    if Theme.winui && !touch.pressed: BottomEdge {
        background: root.primary ? #00000040 : Theme.stroke;
        x: root.border-radius;
        y: root.height - 1px;
        width: root.width - 2 * root.border-radius;
    }

    label := Text {
        text: root.text;
        font-size: Theme.control-text;
        font-weight: Theme.winui ? 400 : 500;
        color: !root.enabled ? Theme.overlay2 : root.primary ? Theme.on-action : Theme.material ? Theme.accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if focus.has-focus: FocusRing {
        target-width: root.width;
        target-height: root.height;
        target-radius: root.border-radius;
    }
}

/// A button around an icon, square or round by style, with an optional small label under it.
export component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    in property <color> rest-color: transparent;
    in property <color> hover-color: Theme.control-hover;
    in property <color> press-color: Theme.control-press;
    /// The press dips the icon slightly, as a physical key would.
    out property <bool> pressed: touch.pressed;

    width: 40px;
    height: 40px;
    border-radius: Theme.round-icons ? self.height / 2 : Theme.radius;
    background: touch.pressed ? press-color : touch.has-hover ? hover-color : rest-color;
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    @children

    if focus.has-focus: FocusRing {
        target-width: root.width;
        target-height: root.height;
        target-radius: root.border-radius;
    }
}

/// A text input: a box, Material's filled field or WinUI's field with an accent edge.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in property <string> label;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited(string);

    public function focus-input() {
        input.focus();
    }

    property <bool> underlined: Theme.material || Theme.winui;
    property <length> corner: Theme.material ? Theme.radius : Theme.corner(self.height);

    min-height: Theme.control-height;
    min-width: 160px;
    clip: underlined;
    border-top-left-radius: corner;
    border-top-right-radius: corner;
    border-bottom-left-radius: Theme.material ? 0px : corner;
    border-bottom-right-radius: Theme.material ? 0px : corner;
    background: Theme.material ? Theme.surface1
        : Theme.winui ? (input.has-focus ? Theme.popup : touch.has-hover ? Theme.control-hover : Theme.control)
        : Theme.catppuccin ? Theme.mantle : Theme.control;
    border-width: Theme.material ? 0px : !underlined && input.has-focus ? max(2px, Theme.border) : Theme.border;
    border-color: !underlined && input.has-focus ? Theme.accent : touch.has-hover && !Theme.winui ? Theme.overlay2 : Theme.stroke;
    animate border-color, background { duration: Theme.settle; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }
    accessible-role: text-input;
    accessible-label: label;

    HorizontalLayout {
        padding-left: Theme.material ? 16px : 10px;
        padding-right: 10px;
        input := TextInput {
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.text-base;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited(self.text);
            }
        }
    }

    if input.text == "": Text {
        x: Theme.material ? 16px : 10px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.subtext;
        font-size: Theme.text-base;
    }

    if root.underlined: Rectangle {
        y: parent.height - self.height;
        height: input.has-focus ? 2px : 1px;
        background: input.has-focus ? Theme.accent : Theme.material ? Theme.subtext : Theme.overlay2;
        animate background { duration: Theme.settle; easing: ease-out; }
    }
}

/// A panel for a row of facts and buttons, as in the account and download lists.
export component Card inherits Rectangle {
    in property <bool> active;
    border-radius: Theme.card-radius;
    background: Theme.card;
    border-width: Theme.material && !active ? 0px : max(Theme.border, active ? 1px : 0px);
    border-color: active ? Theme.accent : Theme.catppuccin ? Theme.surface1 : Theme.rim;
    if Theme.glass: Sheen {
        width: parent.width;
        height: parent.height;
        radius: parent.border-radius;
    }
}

/// A message across the top: offline, login needed or an error.
export component Banner inherits Rectangle {
    in property <string> text;
    /// 0 info, 1 warning, 2 error.
    in property <int> kind;
    in property <string> action;
    callback act();
    callback dismiss();

    background: kind == 2 ? Theme.red : kind == 1 ? Theme.yellow : Theme.surface0;
    animate background { duration: Theme.settle; easing: ease-out; }
    property <bool> arrived;
    init => {
        self.arrived = true;
    }
    opacity: arrived ? 1 : 0;
    animate opacity { duration: Theme.arrive; easing: ease-out-expo; }

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: Theme.gap;
        Text {
            text: root.text;
            color: root.kind == 0 ? Theme.text : Theme.crust;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.action != "": Button {
            text: root.action;
            clicked => {
                root.act();
            }
        }
        IconButton {
            label: @tr("Dismiss");
            clicked => {
                root.dismiss();
            }
            CloseIcon {
                color: root.kind == 0 ? Theme.text : Theme.crust;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

/// A question across the top with two answers, as for a position conflict.
export component Prompt inherits Rectangle {
    in property <string> text;
    in property <string> first;
    in property <string> second;
    callback chose(bool);

    background: Theme.surface0;
    border-width: 1px;
    border-color: Theme.accent;
    property <bool> arrived;
    init => {
        self.arrived = true;
    }
    opacity: arrived ? 1 : 0;
    animate opacity { duration: Theme.arrive; easing: ease-out-expo; }
    accessible-role: groupbox;
    accessible-label: text;

    HorizontalLayout {
        padding: Theme.gap;
        padding-left: Theme.pad;
        spacing: Theme.gap;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        Button {
            text: root.first;
            primary: true;
            clicked => {
                root.chose(true);
            }
        }
        Button {
            text: root.second;
            clicked => {
                root.chose(false);
            }
        }
    }
}

export component Heading inherits Text {
    font-size: Theme.text-xl;
    font-weight: Theme.heading-weight;
    color: Theme.text;
    overflow: elide;
}

export component Label inherits Text {
    font-size: Theme.text-sm;
    color: Theme.subtext;
    overflow: elide;
}
