// Square-cornered controls on the Catppuccin theme.

import { Theme } from "theme.slint";
import { CloseIcon } from "icons.slint";

/// Square focus ring drawn outside its parent.
component FocusRing inherits Rectangle {
    in property <length> target-width;
    in property <length> target-height;
    x: -3px;
    y: -3px;
    width: target-width + 6px;
    height: target-height + 6px;
    border-width: 2px;
    border-color: Theme.accent;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    min-width: max(88px, label.preferred-width + 24px);
    min-height: 36px;
    background: !enabled ? Theme.mantle
        : primary ? (touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
        : (touch.has-hover ? Theme.surface0 : Theme.base);
    border-width: 1px;
    border-color: primary && enabled ? Theme.accent : Theme.overlay0;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    label := Text {
        text: root.text;
        font-size: Theme.text-sm;
        font-weight: 500;
        color: !root.enabled ? Theme.overlay2 : root.primary ? Theme.on-accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if focus.has-focus: FocusRing {
        target-width: root.width;
        target-height: root.height;
    }
}

/// A square button around an icon, with an optional small label under it.
export component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 40px;
    height: 40px;
    background: touch.has-hover ? Theme.surface0 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    @children

    if focus.has-focus: FocusRing {
        target-width: root.width;
        target-height: root.height;
    }
}

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in property <string> label;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited(string);

    public function focus-input() {
        input.focus();
    }

    min-height: 36px;
    min-width: 160px;
    background: Theme.mantle;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.overlay0;
    accessible-role: text-input;
    accessible-label: label;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        input := TextInput {
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.text-base;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited(self.text);
            }
        }
    }

    if input.text == "": Text {
        x: 10px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.subtext;
        font-size: Theme.text-base;
    }
}

/// One choice out of a few, as a row of joined buttons.
export component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback select(int);

    spacing: -1px;
    accessible-role: tab-list;
    accessible-label: label;

    for option[index] in options: Rectangle {
        min-width: max(48px, option-text.preferred-width + 20px);
        min-height: 32px;
        background: index == root.selected ? Theme.accent : touch.has-hover ? Theme.surface0 : Theme.base;
        border-width: 1px;
        border-color: index == root.selected ? Theme.accent : Theme.overlay0;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: index == root.selected;
        accessible-action-default => {
            root.select(index);
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select(index);
            }
        }
        option-text := Text {
            text: option;
            font-size: Theme.text-sm;
            color: index == root.selected ? Theme.on-accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// A horizontal bar to show and change a position from 0 to 1.
export component SeekBar inherits Rectangle {
    in property <float> value;
    in property <string> label;
    /// Positions from 0 to 1 drawn as gaps, such as chapter starts.
    in property <[float]> markers;
    callback seek(float);
    /// While dragging, for controls that apply at once such as volume.
    callback scrub(float);
    property <float> drag;
    property <float> shown: touch.pressed ? drag : clamp(value, 0, 1);

    min-height: 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: round(shown * 100) + "%";

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        background: Theme.surface1;
    }

    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: parent.width * root.shown;
        background: Theme.accent;
    }

    for marker in root.markers: Rectangle {
        x: parent.width * marker - 1px;
        y: (parent.height - 4px) / 2;
        width: 2px;
        height: 4px;
        background: Theme.base;
    }

    Rectangle {
        x: parent.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        background: Theme.accent;
        visible: touch.has-hover || touch.pressed;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag = clamp(self.mouse-x / self.width, 0, 1);
                root.scrub(root.drag);
            } else if event.kind == PointerEventKind.up {
                root.seek(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        moved => {
            root.drag = clamp(self.mouse-x / self.width, 0, 1);
            root.scrub(root.drag);
        }
    }
}

/// A message across the top: offline, login needed or an error.
export component Banner inherits Rectangle {
    in property <string> text;
    /// 0 info, 1 warning, 2 error.
    in property <int> kind;
    in property <string> action;
    callback act();
    callback dismiss();

    background: kind == 2 ? Theme.red : kind == 1 ? Theme.yellow : Theme.surface0;

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: Theme.gap;
        Text {
            text: root.text;
            color: root.kind == 0 ? Theme.text : Theme.crust;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.action != "": Button {
            text: root.action;
            clicked => {
                root.act();
            }
        }
        IconButton {
            label: @tr("Dismiss");
            clicked => {
                root.dismiss();
            }
            CloseIcon {
                color: root.kind == 0 ? Theme.text : Theme.crust;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

export component Heading inherits Text {
    font-size: Theme.text-xl;
    font-weight: 700;
    color: Theme.text;
    overflow: elide;
}

export component Label inherits Text {
    font-size: Theme.text-sm;
    color: Theme.subtext;
    overflow: elide;
}
