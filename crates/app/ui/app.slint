import "fonts/ronzino-regular.ttf";
import "fonts/ronzino-medium.ttf";
import "fonts/ronzino-bold.ttf";
import "fonts/fira-code-variable.ttf";

import { ListView } from "std-widgets.slint";
import { Theme, Colors } from "theme.slint";
import { Ui } from "state.slint";
import { Strings } from "strings.slint";
import { Page } from "data.slint";
import { Banner, IconButton, Label, Prompt } from "widgets.slint";
import { BackIcon } from "icons.slint";
import { HomePage } from "pages/home.slint";
import { LibraryPage, GroupPage, SearchPage } from "pages/library.slint";
import { DetailPage } from "pages/detail.slint";
import { PlayerBar, PlayerPage } from "pages/player.slint";
import { PeekCard } from "tiles.slint";
import { SettingsPage, AddAccountPage } from "pages/settings.slint";
import { WorksPage, WorkPage } from "pages/works.slint";

export { Ui, Theme, Strings, Colors }
export * from "data.slint";

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    min-height: 36px;
    background: selected ? Theme.surface0 : touch.has-hover ? Theme.crust : Theme.crust.transparentize(1);
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: button;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? parent.height : 0;
        background: Theme.accent;
        animate height { duration: Theme.settle; easing: ease-out-expo; }
    }
    Text {
        x: root.selected || touch.has-hover ? Theme.pad + 2px : Theme.pad;
        animate x { duration: Theme.settle; easing: ease-out-expo; }
        width: parent.width - 2 * Theme.pad;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: Theme.text-base;
        font-weight: root.selected ? 700 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Sidebar inherits Rectangle {
    width: 184px;
    background: Theme.mantle;
    VerticalLayout {
        padding-top: Theme.pad;
        padding-bottom: Theme.pad;
        spacing: 2px;
        Text {
            x: Theme.pad;
            text: @tr("Audiobookshelf");
            color: Theme.text;
            font-size: Theme.text-lg;
            font-weight: 700;
        }
        Label {
            x: Theme.pad;
            text: Ui.syncing ? @tr("{} · syncing", Ui.account-label) : Ui.account-label;
        }
        Rectangle {
            height: Theme.pad;
        }
        NavItem {
            text: @tr("Home");
            selected: Ui.page == Page.home;
            clicked => {
                Ui.navigate(Page.home);
            }
        }
        NavItem {
            text: @tr("Search");
            selected: Ui.page == Page.search;
            clicked => {
                Ui.navigate(Page.search);
            }
        }
        NavItem {
            text: @tr("Player");
            selected: Ui.page == Page.player;
            clicked => {
                Ui.navigate(Page.player);
            }
        }
        if Ui.multi-account: NavItem {
            text: @tr("All accounts");
            selected: Ui.page == Page.works || Ui.page == Page.work;
            clicked => {
                Ui.navigate(Page.works);
            }
        }
        Rectangle {
            height: Theme.pad;
        }
        Label {
            x: Theme.pad;
            text: @tr("Libraries");
        }
        for library[index] in Ui.libraries: NavItem {
            text: library.name;
            selected: (Ui.page == Page.library || Ui.page == Page.group) && Ui.library-index == index;
            clicked => {
                Ui.select-library(index);
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        NavItem {
            text: @tr("Settings");
            selected: Ui.page == Page.settings;
            clicked => {
                Ui.navigate(Page.settings);
            }
        }
    }
}

/// Shows one page; a page that becomes current fades in and rises into place.
component PageFrame inherits Rectangle {
    in property <bool> shown;
    visible: shown;

    states [
        current when root.shown: {
            opacity: 1;
            y: 0;
            in {
                animate opacity, y { duration: Theme.arrive; easing: ease-out-expo; }
            }
        }
        away when !root.shown: {
            opacity: 0;
            y: Theme.rise;
        }
    ]

    @children
}

component Pages inherits Rectangle {
    property <Page> page: Ui.page;
    changed page => {
        Ui.peek-id = "";
    }
    property <int> focus-request: Ui.focus-request;
    changed focus-request => {
        if Ui.page == Page.search {
            search.focus-input();
        } else if Ui.page == Page.add-account {
            add.focus-input();
        }
    }

    PageFrame {
        shown: Ui.page == Page.home;
        HomePage { }
    }
    PageFrame {
        shown: Ui.page == Page.library;
        LibraryPage { }
    }
    PageFrame {
        shown: Ui.page == Page.group;
        GroupPage { }
    }
    PageFrame {
        shown: Ui.page == Page.search;
        search := SearchPage { }
    }
    PageFrame {
        shown: Ui.page == Page.detail;
        DetailPage { }
    }
    PageFrame {
        shown: Ui.page == Page.player;
        PlayerPage { }
    }
    PageFrame {
        shown: Ui.page == Page.settings;
        SettingsPage { }
    }
    PageFrame {
        shown: Ui.page == Page.works;
        WorksPage { }
    }
    PageFrame {
        shown: Ui.page == Page.work;
        WorkPage { }
    }
    PageFrame {
        shown: Ui.page == Page.add-account;
        add := AddAccountPage { }
    }

    if Ui.can-go-back && Ui.page != Page.add-account: IconButton {
        x: parent.width - self.width - Theme.gap;
        y: Theme.gap;
        label: @tr("Back");
        clicked => {
            Ui.back();
        }
        BackIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component AppWindow inherits Window {
    title: Ui.has-media ? @tr("{} · Audiobookshelf", Ui.now-title) : @tr("Audiobookshelf");
    icon: @image-url("../../../packaging/icons/abs-desktop.png");
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.base;
    default-font-family: Theme.font;
    default-font-size: 16px;

    keys := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                Ui.back();
                return accept;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                Ui.navigate(Page.search);
                return accept;
            }
            if !Ui.has-media || Ui.page == Page.add-account {
                return reject;
            }
            if event.text == " " {
                Ui.toggle-play();
                return accept;
            }
            if event.text == Key.UpArrow {
                Ui.set-volume(min(100, Ui.volume + 5));
                return accept;
            }
            if event.text == Key.DownArrow {
                Ui.set-volume(max(0, Ui.volume - 5));
                return accept;
            }
            if event.text == Key.LeftArrow {
                if event.modifiers.shift {
                    Ui.previous-chapter();
                } else {
                    Ui.skip-back();
                }
                return accept;
            }
            if event.text == Key.RightArrow {
                if event.modifiers.shift {
                    Ui.next-chapter();
                } else {
                    Ui.skip-forward();
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            if Ui.conflict-text != "": Prompt {
                text: Ui.conflict-text;
                first: Ui.conflict-keep-text;
                second: Ui.conflict-take-text;
                chose(keep) => {
                    Ui.resolve-conflict(keep);
                }
            }
            if Ui.banner-text != "": Banner {
                text: Ui.banner-text;
                kind: Ui.banner-kind;
                action: Ui.banner-action;
                act => {
                    Ui.banner-act();
                }
                dismiss => {
                    Ui.banner-dismiss();
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                if Ui.page != Page.add-account || Ui.add-can-cancel: Sidebar { }
                Pages {
                    horizontal-stretch: 1;
                }
            }
            if Ui.has-media || Ui.loading-media: PlayerBar { }
        }

        PeekCard {
            window-width: root.width;
            window-height: root.height;
        }
    }
}
