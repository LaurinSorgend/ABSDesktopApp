import "fonts/ronzino-regular.ttf";
import "fonts/ronzino-medium.ttf";
import "fonts/ronzino-bold.ttf";
import "fonts/fira-code-variable.ttf";

import { ListView } from "std-widgets.slint";
import { Theme, Colors, Look, ThemeStyle } from "theme.slint";
import { Ui } from "state.slint";
import { Strings } from "strings.slint";
import { Page } from "data.slint";
import { Banner, IconButton, Label, Prompt } from "widgets.slint";
import { BackIcon } from "icons.slint";
import { HomePage } from "pages/home.slint";
import { LibraryPage, GroupPage, SearchPage } from "pages/library.slint";
import { DetailPage } from "pages/detail.slint";
import { PlayerBar, PlayerPage, PlayerPanel } from "pages/player.slint";
import { FullScreenPlayer, MiniPlayer } from "pages/views.slint";
import { PeekCard } from "tiles.slint";
import { SettingsPage, AddAccountPage } from "pages/settings.slint";
import { WorksPage, WorkPage } from "pages/works.slint";

import { Backdrop, ContentLayer, Sidebar, TopNav } from "shell.slint";

export { Ui, Theme, Strings, Colors, Look, ThemeStyle }
export * from "data.slint";

/// Shows one page; a page that becomes current fades in and rises into place.
component PageFrame inherits Rectangle {
    in property <bool> shown;
    visible: shown;

    states [
        current when root.shown: {
            opacity: 1;
            y: 0;
            in {
                animate opacity, y { duration: Theme.arrive; easing: ease-out-expo; }
            }
        }
        away when !root.shown: {
            opacity: 0;
            y: Theme.rise;
        }
    ]

    @children
}

component Pages inherits Rectangle {
    property <Page> page: Ui.page;
    changed page => {
        Ui.peek-id = "";
    }
    property <int> focus-request: Ui.focus-request;
    changed focus-request => {
        if Ui.page == Page.search {
            search.focus-input();
        } else if Ui.page == Page.add-account {
            add.focus-input();
        }
    }

    PageFrame {
        shown: Ui.page == Page.home;
        HomePage { }
    }
    PageFrame {
        shown: Ui.page == Page.library;
        LibraryPage { }
    }
    PageFrame {
        shown: Ui.page == Page.group;
        GroupPage { }
    }
    PageFrame {
        shown: Ui.page == Page.search;
        search := SearchPage { }
    }
    PageFrame {
        shown: Ui.page == Page.detail;
        DetailPage { }
    }
    PageFrame {
        shown: Ui.page == Page.player;
        PlayerPage { }
    }
    PageFrame {
        shown: Ui.page == Page.settings;
        SettingsPage { }
    }
    PageFrame {
        shown: Ui.page == Page.works;
        WorksPage { }
    }
    PageFrame {
        shown: Ui.page == Page.work;
        WorkPage { }
    }
    PageFrame {
        shown: Ui.page == Page.add-account;
        add := AddAccountPage { }
    }

    if Ui.can-go-back && Ui.page != Page.add-account: IconButton {
        x: parent.width - self.width - Theme.gap;
        y: Theme.gap;
        label: @tr("Back");
        clicked => {
            Ui.back();
        }
        BackIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component AppWindow inherits Window {
    title: Ui.has-media ? @tr("{} · Audiobookshelf", Ui.now-title) : @tr("Audiobookshelf");
    icon: @image-url("../../../packaging/icons/abs-desktop.png");
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: Ui.view == 1 ? 400px : 720px;
    min-height: Ui.view == 1 ? 180px : 480px;
    no-frame: Ui.view == 1;
    always-on-top: Ui.view == 1 && Ui.mini-on-top;
    background: Theme.mica ? transparent : Theme.base;
    default-font-family: Theme.font;
    /// The system can switch between light and dark at any time; the frame and the
    /// accent swatches follow.
    property <bool> dark: Theme.dark;
    changed dark => {
        Ui.reload-theme();
    }
    default-font-size: Theme.text-base;
    property <bool> nav: Ui.page != Page.add-account || Ui.add-can-cancel;
    property <bool> player: Ui.has-media || Ui.loading-media;

    if Theme.backdrop && Ui.view == 0: Backdrop { }

    keys := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.F11 && Ui.view != 1 {
                Ui.set-view(Ui.view == 2 ? 0 : 2);
                return accept;
            }
            if event.text == Key.Escape {
                if Ui.view == 2 {
                    Ui.set-view(0);
                } else if Ui.view == 0 {
                    Ui.back();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                Ui.navigate(Page.search);
                return accept;
            }
            if !Ui.has-media || Ui.page == Page.add-account {
                return reject;
            }
            if event.text == " " {
                Ui.toggle-play();
                return accept;
            }
            if event.text == Key.UpArrow {
                Ui.set-volume(min(100, Ui.volume + 5));
                return accept;
            }
            if event.text == Key.DownArrow {
                Ui.set-volume(max(0, Ui.volume - 5));
                return accept;
            }
            if event.text == Key.LeftArrow {
                if event.modifiers.shift {
                    Ui.previous-chapter();
                } else {
                    Ui.skip-back();
                }
                return accept;
            }
            if event.text == Key.RightArrow {
                if event.modifiers.shift {
                    Ui.next-chapter();
                } else {
                    Ui.skip-forward();
                }
                return accept;
            }
            reject
        }

        if Ui.view == 1: MiniPlayer { }

        if Ui.view != 1: VerticalLayout {
            if Ui.conflict-text != "": Prompt {
                text: Ui.conflict-text;
                first: Ui.conflict-keep-text;
                second: Ui.conflict-take-text;
                chose(keep) => {
                    Ui.resolve-conflict(keep);
                }
            }
            if Ui.banner-text != "": Banner {
                text: Ui.banner-text;
                kind: Ui.banner-kind;
                action: Ui.banner-action;
                act => {
                    Ui.banner-act();
                }
                dismiss => {
                    Ui.banner-dismiss();
                }
            }
            if root.nav && Theme.nav-top: TopNav { }
            if root.player && Theme.player-position == 1: PlayerBar { }
            HorizontalLayout {
                vertical-stretch: 1;
                if root.nav && Theme.nav-position == 0: Sidebar { }
                if root.player && Theme.player-position == 2: PlayerPanel { }
                ContentLayer {
                    horizontal-stretch: 1;
                    Pages {
                        width: parent.width;
                        height: parent.height;
                    }
                }
                if root.player && Theme.player-position == 3: PlayerPanel { }
                if root.nav && Theme.nav-position == 1: Sidebar { }
            }
            if root.player && Theme.player-position == 0: PlayerBar { }
        }

        if Ui.view == 0: PeekCard {
            window-width: root.width;
            window-height: root.height;
        }

        if Ui.view == 2: FullScreenPlayer { }
    }
}
