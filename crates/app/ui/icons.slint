// Player icons on a 24 x 24 grid.

import { Theme } from "theme.slint";

component IconBase inherits Path {
    in property <color> color: Theme.text;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: color;
}

component StrokeIcon inherits Path {
    in property <color> color: Theme.text;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2px;
}

export component PlayIcon inherits IconBase {
    commands: "M 7 4 L 20 12 L 7 20 Z";
}

export component PauseIcon inherits IconBase {
    commands: "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z";
}

export component PreviousIcon inherits IconBase {
    commands: "M 5 5 L 7 5 L 7 19 L 5 19 Z M 19 5 L 8 12 L 19 19 Z";
}

export component NextIcon inherits IconBase {
    commands: "M 17 5 L 19 5 L 19 19 L 17 19 Z M 5 5 L 16 12 L 5 19 Z";
}

export component RewindIcon inherits IconBase {
    commands: "M 12 6 L 3 12 L 12 18 Z M 21 6 L 12 12 L 21 18 Z";
}

export component ForwardIcon inherits IconBase {
    commands: "M 3 6 L 12 12 L 3 18 Z M 12 6 L 21 12 L 12 18 Z";
}

export component VolumeIcon inherits IconBase {
    commands: "M 3 9 L 7 9 L 12 4 L 12 20 L 7 15 L 3 15 Z M 15 8 L 16.5 6.5 A 8 8 0 0 1 16.5 17.5 L 15 16 A 6 6 0 0 0 15 8 Z";
}

export component MutedIcon inherits IconBase {
    commands: "M 3 9 L 7 9 L 12 4 L 12 20 L 7 15 L 3 15 Z M 15 9 L 16 8 L 18.5 10.5 L 21 8 L 22 9 L 19.5 11.5 L 22 14 L 21 15 L 18.5 12.5 L 16 15 L 15 14 L 17.5 11.5 Z";
}

export component BookmarkIcon inherits IconBase {
    commands: "M 6 3 L 18 3 L 18 21 L 12 16 L 6 21 Z";
}

export component DownloadIcon inherits IconBase {
    commands: "M 11 3 L 13 3 L 13 12 L 16.5 8.5 L 18 10 L 12 16 L 6 10 L 7.5 8.5 L 11 12 Z M 4 18 L 20 18 L 20 20 L 4 20 Z";
}

export component SearchIcon inherits StrokeIcon {
    commands: "M 10 4 A 6 6 0 1 0 10 16 A 6 6 0 1 0 10 4 Z M 14.5 14.5 L 20 20";
}

export component CloseIcon inherits StrokeIcon {
    commands: "M 6 6 L 18 18 M 18 6 L 6 18";
}

export component BackIcon inherits StrokeIcon {
    commands: "M 15 5 L 8 12 L 15 19";
}
