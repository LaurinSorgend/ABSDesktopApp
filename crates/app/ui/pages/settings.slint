import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Ui } from "../state.slint";
import { AccountData, DownloadData } from "../data.slint";
import { Button, Card, Dropdown, Heading, Label, Segmented, TextField } from "../widgets.slint";
import { Appearance, DropdownSetting, Setting, SectionTitle, SettingsLayout } from "appearance.slint";

component AccountRow inherits Card {
    in property <AccountData> account;
    min-height: 56px;
    active: account.active;
    HorizontalLayout {
        padding: Theme.gap;
        padding-left: Theme.pad;
        spacing: Theme.gap;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.account.active ? @tr("{} (active)", root.account.username) : root.account.username;
                color: Theme.text;
                font-weight: 500;
                overflow: elide;
            }
            Label {
                text: root.account.server + " · " + root.account.status;
            }
        }
        if root.account.needs-login: Button {
            text: @tr("Log in");
            primary: true;
            clicked => {
                Ui.relogin(root.account.id);
            }
        }
        if !root.account.active: Button {
            text: @tr("Use");
            clicked => {
                Ui.use-account(root.account.id);
            }
        }
        Button {
            text: root.account.enabled ? @tr("Turn off") : @tr("Turn on");
            clicked => {
                Ui.set-account-enabled(root.account.id, !root.account.enabled);
            }
        }
        Button {
            text: @tr("Remove");
            clicked => {
                Ui.remove-account(root.account.id);
            }
        }
    }
}

component DownloadRow inherits Card {
    in property <DownloadData> download;
    min-height: 56px;
    HorizontalLayout {
        padding: Theme.gap;
        padding-left: Theme.pad;
        spacing: Theme.gap;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.download.title;
                color: Theme.text;
                font-weight: 500;
                overflow: elide;
            }
            Label {
                text: root.download.status;
                color: root.download.state == 5 ? Theme.red : Theme.subtext;
                overflow: elide;
            }
        }
        if root.download.state == 1 || root.download.state == 2: Button {
            text: @tr("Pause");
            clicked => {
                Ui.pause-download(root.download.account-id, root.download.item-id);
            }
        }
        if root.download.state == 3 || root.download.state == 5: Button {
            text: root.download.state == 5 ? @tr("Retry") : @tr("Resume");
            clicked => {
                Ui.resume-download(root.download.account-id, root.download.item-id);
            }
        }
        Button {
            text: root.download.state == 4 ? @tr("Remove") : @tr("Cancel");
            clicked => {
                Ui.delete-download(root.download.account-id, root.download.item-id);
            }
        }
    }
}

component Downloads inherits VerticalLayout {
    spacing: SettingsLayout.spacing;
    SectionTitle {
        text: @tr("Downloads");
    }
    VerticalLayout {
        spacing: 4px;
        Label {
            text: @tr("Download folder");
        }
        Text {
            text: Ui.download-folder;
            color: Theme.text;
            wrap: word-wrap;
        }
        Label {
            text: @tr("New downloads go here. Downloads already on this computer stay where they are.");
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: Theme.gap;
        Button {
            text: @tr("Choose folder…");
            clicked => {
                Ui.choose-download-folder();
            }
        }
        if Ui.download-folder-custom: Button {
            text: @tr("Use the default folder");
            clicked => {
                Ui.reset-download-folder();
            }
        }
    }
    Label {
        text: Ui.downloads.length == 0 ? @tr("Nothing is downloaded.") : @tr("Downloads use {}.", Ui.downloads-used-text);
    }
    for download in Ui.downloads: DownloadRow {
        download: download;
    }
}

/// The addresses of the active account's server, with add, remove and move up.
component ServerAddresses inherits VerticalLayout {
    spacing: 4px;
    Label {
        text: @tr("Server addresses");
    }
    Label {
        text: @tr("The app tries them from the top and uses the first that answers, so put the address for your home network first.");
        wrap: word-wrap;
    }
    for url[index] in Ui.server-urls: Card {
        min-height: 44px;
        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.gap;
            spacing: Theme.gap;
            Text {
                text: url;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if index > 0: Button {
                text: @tr("Move up");
                clicked => {
                    Ui.raise-server-url(index);
                }
            }
            if Ui.server-urls.length > 1: Button {
                text: @tr("Remove");
                clicked => {
                    Ui.remove-server-url(index);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        TextField {
            label: @tr("New server address");
            placeholder: "http://192.168.1.10:13378";
            text <=> Ui.new-server-url;
            horizontal-stretch: 1;
            accepted => {
                Ui.add-server-url(Ui.new-server-url);
            }
        }
        Button {
            text: @tr("Add address");
            enabled: Ui.new-server-url != "";
            clicked => {
                Ui.add-server-url(Ui.new-server-url);
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    ScrollView {
        content-height: max(self.height, content.preferred-height);
        content := VerticalLayout {
            padding: Theme.page-pad;
            spacing: SettingsLayout.spacing;
            alignment: start;
            max-width: 1040px + 2 * Theme.page-pad;
            Heading {
                text: @tr("Settings");
            }
            SectionTitle {
                text: @tr("Accounts");
            }
            for account in Ui.accounts: AccountRow {
                account: account;
            }
            if Ui.server-urls.length > 0: ServerAddresses { }
            if Ui.credentials-note != "": Label {
                text: Ui.credentials-note;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.gap;
                Button {
                    text: @tr("Add account");
                    clicked => {
                        Ui.add-another-account();
                    }
                }
                Button {
                    text: Ui.syncing ? @tr("Syncing…") : @tr("Sync now");
                    enabled: !Ui.syncing;
                    clicked => {
                        Ui.sync-now();
                    }
                }
            }
            SectionTitle {
                text: @tr("Playback");
            }
            Setting {
                title: @tr("Skip back");
                options: Ui.skip-back-options;
                selected: Ui.skip-back-index;
                key: "skip_back";
            }
            Setting {
                title: @tr("Skip forward");
                options: Ui.skip-forward-options;
                selected: Ui.skip-forward-index;
                key: "skip_forward";
            }
            Setting {
                title: @tr("Speed");
                options: Ui.speed-options;
                selected: Ui.default-speed-index;
                key: "default_speed";
            }
            Setting {
                title: @tr("Progress bar in the player bar");
                options: [@tr("Book"), @tr("Chapter"), @tr("Both")];
                selected: Ui.progress-mode;
                key: "progress_bar";
            }
            Setting {
                title: @tr("When closing the window while playing");
                options: [@tr("Quit"), @tr("Keep playing in the tray")];
                selected: Ui.close-to-tray ? 1 : 0;
                key: "close_to_tray";
            }
            Setting {
                title: @tr("Ask which position to keep when offline listening and another device differ by more than");
                options: Ui.conflict-options;
                selected: Ui.conflict-index;
                key: "conflict_minutes";
            }
            Setting {
                title: @tr("While paused, look for progress from other devices every");
                options: Ui.remote-check-options;
                selected: Ui.remote-check-index;
                key: "remote_check_seconds";
            }
            if Ui.multi-account: SectionTitle {
                text: @tr("Books on several accounts");
            }
            if Ui.multi-account: DropdownSetting {
                title: @tr("Play from this account when no copy has progress or a download");
                options: Ui.preferred-account-options;
                selected: Ui.preferred-account-index;
                key: "preferred_account";
            }
            if Ui.multi-account: Setting {
                title: @tr("Copy the position to copies of the same recording on other accounts");
                options: [@tr("Off"), @tr("On")];
                selected: Ui.mirror-progress ? 1 : 0;
                key: "mirror_progress";
            }
            Appearance { }
            SectionTitle {
                text: @tr("Storage");
            }
            Setting {
                title: @tr("Cover cache size ({} used)", Ui.cache-used-text);
                options: Ui.cache-options;
                selected: Ui.cache-index;
                key: "cover_cache";
            }
            Downloads { }
        }
    }
}

export component AddAccountPage inherits Rectangle {
    property <bool> with-key: Ui.add-method == 1;
    property <bool> complete: Ui.add-url != "" && (with-key ? Ui.add-key != "" : Ui.add-username != "");

    public function focus-input() {
        url.focus-input();
    }
    function submit() {
        if !root.complete || Ui.add-busy {
            return;
        }
        if root.with-key {
            Ui.add-account-with-key(Ui.add-url, Ui.add-key);
        } else {
            Ui.add-account(Ui.add-url, Ui.add-username, Ui.add-password);
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            padding: Theme.page-pad;
            VerticalLayout {
                max-width: 420px;
                horizontal-stretch: 1;
                spacing: Theme.pad;
                Heading {
                    text: Ui.add-title;
                }
                Label {
                    text: @tr("Enter the address of your Audiobookshelf server and your login.");
                    font-size: Theme.text-base;
                    wrap: word-wrap;
                }
                Label {
                    text: @tr("Server address");
                }
                url := TextField {
                    label: @tr("Server address");
                    placeholder: "https://abs.example.com";
                    text <=> Ui.add-url;
                    accepted => {
                        if root.with-key {
                            key.focus-input();
                        } else {
                            user.focus-input();
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        label: @tr("Log in with");
                        options: [@tr("Password"), @tr("API key")];
                        selected: Ui.add-method;
                        select(index) => {
                            Ui.add-method = index;
                        }
                    }
                }
                VerticalLayout {
                    VerticalLayout {
                        visible: !root.with-key;
                        height: root.with-key ? 0px : self.preferred-height;
                        spacing: Theme.pad;
                        Label {
                            text: @tr("Username");
                        }
                        user := TextField {
                            label: @tr("Username");
                            text <=> Ui.add-username;
                            accepted => {
                                pass.focus-input();
                            }
                        }
                        Label {
                            text: @tr("Password");
                        }
                        pass := TextField {
                            label: @tr("Password");
                            password: true;
                            text <=> Ui.add-password;
                            accepted => {
                                root.submit();
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.with-key;
                        height: root.with-key ? self.preferred-height : 0px;
                        spacing: Theme.pad;
                        Label {
                            text: @tr("API key");
                        }
                        key := TextField {
                            label: @tr("API key");
                            password: true;
                            text <=> Ui.add-key;
                            accepted => {
                                root.submit();
                            }
                        }
                        Label {
                            text: @tr("For servers that only allow single sign-on. An admin creates the key under Settings, API Keys, for your user.");
                            font-size: Theme.text-sm;
                            wrap: word-wrap;
                        }
                    }
                }
                if Ui.add-error != "": Text {
                    text: Ui.add-error;
                    color: Theme.red;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    if Ui.add-can-cancel: Button {
                        text: @tr("Cancel");
                        clicked => {
                            Ui.back();
                        }
                    }
                    Button {
                        text: Ui.add-busy ? @tr("Connecting…") : @tr("Log in");
                        primary: true;
                        enabled: !Ui.add-busy && root.complete;
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
    }
}
