import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Ui } from "../state.slint";
import { AccountData, DownloadData } from "../data.slint";

/// The accent colors of the current flavor as square swatches.
component AccentPicker inherits HorizontalLayout {
    spacing: 4px;
    alignment: start;
    accessible-role: tab-list;
    accessible-label: @tr("Accent color");
    for swatch[index] in Ui.accent-swatches: Rectangle {
        width: 32px;
        height: 32px;
        background: swatch;
        border-width: index == Ui.accent-index ? 3px : touch.has-hover ? 2px : 1px;
        border-color: index == Ui.accent-index || touch.has-hover ? Theme.text : Theme.overlay0;
        animate border-width, border-color { duration: Theme.quick; easing: ease-out; }
        accessible-role: tab;
        accessible-label: Ui.accent-names[index];
        accessible-item-selected: index == Ui.accent-index;
        accessible-action-default => {
            Ui.set-setting("accent", index);
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Ui.set-setting("accent", index);
            }
        }
    }
}
import { Button, Heading, Label, Segmented, TextField } from "../widgets.slint";

component AccountRow inherits Rectangle {
    in property <AccountData> account;
    min-height: 56px;
    border-width: 1px;
    border-color: account.active ? Theme.accent : Theme.surface1;
    HorizontalLayout {
        padding: Theme.gap;
        padding-left: Theme.pad;
        spacing: Theme.gap;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.account.active ? @tr("{} (active)", root.account.username) : root.account.username;
                color: Theme.text;
                font-weight: 500;
                overflow: elide;
            }
            Label {
                text: root.account.server + " · " + root.account.status;
            }
        }
        if root.account.needs-login: Button {
            text: @tr("Log in");
            primary: true;
            clicked => {
                Ui.relogin(root.account.id);
            }
        }
        if !root.account.active: Button {
            text: @tr("Use");
            clicked => {
                Ui.use-account(root.account.id);
            }
        }
        Button {
            text: @tr("Remove");
            clicked => {
                Ui.remove-account(root.account.id);
            }
        }
    }
}

component DownloadRow inherits Rectangle {
    in property <DownloadData> download;
    min-height: 56px;
    border-width: 1px;
    border-color: Theme.surface1;
    HorizontalLayout {
        padding: Theme.gap;
        padding-left: Theme.pad;
        spacing: Theme.gap;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.download.title;
                color: Theme.text;
                font-weight: 500;
                overflow: elide;
            }
            Label {
                text: root.download.status;
                color: root.download.state == 5 ? Theme.red : Theme.subtext;
                overflow: elide;
            }
        }
        if root.download.state == 1 || root.download.state == 2: Button {
            text: @tr("Pause");
            clicked => {
                Ui.pause-download(root.download.account-id, root.download.item-id);
            }
        }
        if root.download.state == 3 || root.download.state == 5: Button {
            text: root.download.state == 5 ? @tr("Retry") : @tr("Resume");
            clicked => {
                Ui.resume-download(root.download.account-id, root.download.item-id);
            }
        }
        Button {
            text: root.download.state == 4 ? @tr("Remove") : @tr("Cancel");
            clicked => {
                Ui.delete-download(root.download.account-id, root.download.item-id);
            }
        }
    }
}

component Downloads inherits VerticalLayout {
    spacing: Theme.pad;
    Heading {
        text: @tr("Downloads");
        font-size: Theme.text-lg;
    }
    VerticalLayout {
        spacing: 4px;
        Label {
            text: @tr("Download folder");
        }
        Text {
            text: Ui.download-folder;
            color: Theme.text;
            wrap: word-wrap;
        }
        Label {
            text: @tr("New downloads go here. Downloads already on this computer stay where they are.");
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: Theme.gap;
        Button {
            text: @tr("Choose folder…");
            clicked => {
                Ui.choose-download-folder();
            }
        }
        if Ui.download-folder-custom: Button {
            text: @tr("Use the default folder");
            clicked => {
                Ui.reset-download-folder();
            }
        }
    }
    Label {
        text: Ui.downloads.length == 0 ? @tr("Nothing is downloaded.") : @tr("Downloads use {}.", Ui.downloads-used-text);
    }
    for download in Ui.downloads: DownloadRow {
        download: download;
    }
}

/// The addresses of the active account's server, with add, remove and move up.
component ServerAddresses inherits VerticalLayout {
    spacing: 4px;
    Label {
        text: @tr("Server addresses");
    }
    Label {
        text: @tr("The app tries them from the top and uses the first that answers, so put the address for your home network first.");
        wrap: word-wrap;
    }
    for url[index] in Ui.server-urls: Rectangle {
        min-height: 44px;
        border-width: 1px;
        border-color: Theme.surface1;
        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.gap;
            spacing: Theme.gap;
            Text {
                text: url;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if index > 0: Button {
                text: @tr("Move up");
                clicked => {
                    Ui.raise-server-url(index);
                }
            }
            if Ui.server-urls.length > 1: Button {
                text: @tr("Remove");
                clicked => {
                    Ui.remove-server-url(index);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        TextField {
            label: @tr("New server address");
            placeholder: "http://192.168.1.10:13378";
            text <=> Ui.new-server-url;
            horizontal-stretch: 1;
            accepted => {
                Ui.add-server-url(Ui.new-server-url);
            }
        }
        Button {
            text: @tr("Add address");
            enabled: Ui.new-server-url != "";
            clicked => {
                Ui.add-server-url(Ui.new-server-url);
            }
        }
    }
}

component Setting inherits VerticalLayout {
    in property <string> title;
    in property <[string]> options;
    in property <int> selected;
    in property <string> key;
    spacing: 4px;
    alignment: start;
    Label {
        text: root.title;
    }
    HorizontalLayout {
        alignment: start;
        Segmented {
            label: root.title;
            options: root.options;
            selected: root.selected;
            select(index) => {
                Ui.set-setting(root.key, index);
            }
        }
    }
}

component Appearance inherits VerticalLayout {
    spacing: Theme.pad;
    Heading {
        text: @tr("Appearance");
        font-size: Theme.text-lg;
    }
    Setting {
        title: @tr("Theme");
        options: [@tr("System"), @tr("Light"), @tr("Dark")];
        selected: Ui.theme-mode;
        key: "theme_mode";
    }
    Setting {
        title: @tr("Light theme");
        options: ["Latte", "Frappé", "Macchiato", "Mocha"];
        selected: Ui.light-flavor;
        key: "light_flavor";
    }
    Setting {
        title: @tr("Dark theme");
        options: ["Latte", "Frappé", "Macchiato", "Mocha"];
        selected: Ui.dark-flavor;
        key: "dark_flavor";
    }
    Setting {
        title: @tr("Animations");
        options: [@tr("Off"), @tr("On")];
        selected: Theme.motion ? 1 : 0;
        key: "animations";
    }
    VerticalLayout {
        spacing: 4px;
        Label {
            text: @tr("Accent color: {}", Ui.accent-index >= 0 && Ui.accent-index < Ui.accent-names.length ? Ui.accent-names[Ui.accent-index] : "");
        }
        AccentPicker { }
    }
    VerticalLayout {
        spacing: 4px;
        Label {
            text: @tr("Custom colors");
        }
        Text {
            text: @tr("Colors in {} replace the theme's colors.", Ui.theme-file);
            color: Theme.text;
            wrap: word-wrap;
        }
        if Ui.theme-note != "": Label {
            text: Ui.theme-note;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.gap;
            Button {
                text: @tr("Edit theme file");
                clicked => {
                    Ui.edit-theme-file();
                }
            }
            Button {
                text: @tr("Reload");
                clicked => {
                    Ui.reload-theme();
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    ScrollView {
        content-height: max(self.height, content.preferred-height);
        content := VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.pad;
            alignment: start;
            Heading {
                text: @tr("Settings");
            }
            Heading {
                text: @tr("Accounts");
                font-size: Theme.text-lg;
            }
            for account in Ui.accounts: AccountRow {
                account: account;
            }
            if Ui.server-urls.length > 0: ServerAddresses { }
            if Ui.credentials-note != "": Label {
                text: Ui.credentials-note;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.gap;
                Button {
                    text: @tr("Add account");
                    clicked => {
                        Ui.add-another-account();
                    }
                }
                Button {
                    text: Ui.syncing ? @tr("Syncing…") : @tr("Sync now");
                    enabled: !Ui.syncing;
                    clicked => {
                        Ui.sync-now();
                    }
                }
            }
            Heading {
                text: @tr("Playback");
                font-size: Theme.text-lg;
            }
            Setting {
                title: @tr("Skip back");
                options: Ui.skip-back-options;
                selected: Ui.skip-back-index;
                key: "skip_back";
            }
            Setting {
                title: @tr("Skip forward");
                options: Ui.skip-forward-options;
                selected: Ui.skip-forward-index;
                key: "skip_forward";
            }
            Setting {
                title: @tr("Speed");
                options: Ui.speed-options;
                selected: Ui.default-speed-index;
                key: "default_speed";
            }
            Setting {
                title: @tr("Progress bar in the player bar");
                options: [@tr("Book"), @tr("Chapter"), @tr("Both")];
                selected: Ui.progress-mode;
                key: "progress_bar";
            }
            Setting {
                title: @tr("When closing the window while playing");
                options: [@tr("Quit"), @tr("Keep playing in the tray")];
                selected: Ui.close-to-tray ? 1 : 0;
                key: "close_to_tray";
            }
            Setting {
                title: @tr("Ask which position to keep when offline listening and another device differ by more than");
                options: Ui.conflict-options;
                selected: Ui.conflict-index;
                key: "conflict_minutes";
            }
            Appearance { }
            Heading {
                text: @tr("Storage");
                font-size: Theme.text-lg;
            }
            Setting {
                title: @tr("Cover cache size ({} used)", Ui.cache-used-text);
                options: Ui.cache-options;
                selected: Ui.cache-index;
                key: "cover_cache";
            }
            Downloads { }
        }
    }
}

export component AddAccountPage inherits Rectangle {
    public function focus-input() {
        url.focus-input();
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            padding: Theme.pad;
            VerticalLayout {
                max-width: 420px;
                horizontal-stretch: 1;
                spacing: Theme.pad;
                Heading {
                    text: Ui.add-title;
                }
                Label {
                    text: @tr("Enter the address of your Audiobookshelf server and your login.");
                    font-size: Theme.text-base;
                    wrap: word-wrap;
                }
                Label {
                    text: @tr("Server address");
                }
                url := TextField {
                    label: @tr("Server address");
                    placeholder: "https://abs.example.com";
                    text <=> Ui.add-url;
                    accepted => {
                        user.focus-input();
                    }
                }
                Label {
                    text: @tr("Username");
                }
                user := TextField {
                    label: @tr("Username");
                    text <=> Ui.add-username;
                    accepted => {
                        pass.focus-input();
                    }
                }
                Label {
                    text: @tr("Password");
                }
                pass := TextField {
                    label: @tr("Password");
                    password: true;
                    text <=> Ui.add-password;
                    accepted => {
                        Ui.add-account(Ui.add-url, Ui.add-username, Ui.add-password);
                    }
                }
                if Ui.add-error != "": Text {
                    text: Ui.add-error;
                    color: Theme.red;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    if Ui.add-can-cancel: Button {
                        text: @tr("Cancel");
                        clicked => {
                            Ui.back();
                        }
                    }
                    Button {
                        text: Ui.add-busy ? @tr("Connecting…") : @tr("Log in");
                        primary: true;
                        enabled: !Ui.add-busy && Ui.add-url != "" && Ui.add-username != "";
                        clicked => {
                            Ui.add-account(Ui.add-url, Ui.add-username, Ui.add-password);
                        }
                    }
                }
            }
        }
    }
}
