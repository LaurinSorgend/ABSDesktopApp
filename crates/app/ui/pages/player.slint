import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Ui } from "../state.slint";
import { Page } from "../data.slint";
import { Cover } from "../tiles.slint";
import { ChapterRow } from "detail.slint";
import { Button, Heading, IconButton, Label, Segmented, SeekBar } from "../widgets.slint";
import {
    PlayIcon, PauseIcon, PreviousIcon, NextIcon, RewindIcon, ForwardIcon, BookmarkIcon, CloseIcon,
} from "../icons.slint";

/// Previous chapter, skip back, play/pause, skip forward, next chapter.
export component Transport inherits HorizontalLayout {
    spacing: 4px;
    alignment: center;
    IconButton {
        label: @tr("Previous chapter");
        clicked => {
            Ui.previous-chapter();
        }
        PreviousIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    IconButton {
        label: @tr("Skip back {}", Ui.skip-back-text);
        clicked => {
            Ui.skip-back();
        }
        RewindIcon {
            x: (parent.width - self.width) / 2;
            y: 6px;
            width: 18px;
            height: 18px;
        }
        Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-back-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    IconButton {
        label: Ui.playing ? @tr("Pause") : @tr("Play");
        width: 48px;
        height: 48px;
        background: Theme.accent;
        clicked => {
            Ui.toggle-play();
        }
        if Ui.playing: PauseIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            color: Theme.on-accent;
        }
        if !Ui.playing: PlayIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            color: Theme.on-accent;
        }
    }
    IconButton {
        label: @tr("Skip forward {}", Ui.skip-forward-text);
        clicked => {
            Ui.skip-forward();
        }
        ForwardIcon {
            x: (parent.width - self.width) / 2;
            y: 6px;
            width: 18px;
            height: 18px;
        }
        Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-forward-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    IconButton {
        label: @tr("Next chapter");
        clicked => {
            Ui.next-chapter();
        }
        NextIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

component TimeText inherits Text {
    font-family: Theme.mono;
    font-size: Theme.text-sm;
    color: Theme.subtext;
    vertical-alignment: center;
}

/// The bar at the bottom while an item is loaded.
export component PlayerBar inherits Rectangle {
    height: 72px;
    background: Theme.mantle;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.surface1;
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.pad;
        padding-top: Theme.gap;
        padding-bottom: Theme.gap;
        spacing: Theme.pad;
        Rectangle {
            width: 280px;
            accessible-role: button;
            accessible-label: @tr("Open player");
            accessible-action-default => {
                Ui.navigate(Page.player);
            }
            HorizontalLayout {
                spacing: Theme.gap;
                Cover {
                    width: 56px;
                    height: 56px;
                    source: Ui.now-cover;
                    has-image: Ui.now-has-cover;
                    title: Ui.now-title;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: Ui.now-title;
                        color: Theme.text;
                        font-weight: 500;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                    Label {
                        text: Ui.loading-media ? @tr("Loading…") : Ui.chapter-title != "" ? Ui.chapter-title : Ui.now-author;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Ui.navigate(Page.player);
                }
            }
        }
        Transport { }
        HorizontalLayout {
            spacing: Theme.gap;
            horizontal-stretch: 1;
            TimeText {
                text: Ui.position-text;
            }
            SeekBar {
                label: @tr("Position");
                value: Ui.position-fraction;
                horizontal-stretch: 1;
                seek(fraction) => {
                    Ui.seek-fraction(fraction);
                }
            }
            TimeText {
                text: Ui.remaining-text;
            }
        }
        Button {
            text: Ui.speed-index >= 0 ? Ui.speed-options[Ui.speed-index] : "1×";
            min-width: 56px;
            clicked => {
                Ui.set-speed(mod(Ui.speed-index + 1, Ui.speed-options.length));
            }
        }
    }
}

component BookmarkList inherits VerticalLayout {
    spacing: Theme.gap;
    HorizontalLayout {
        Heading {
            text: @tr("Bookmarks");
            font-size: Theme.text-lg;
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Add bookmark");
            clicked => {
                Ui.add-bookmark();
            }
        }
    }
    if Ui.bookmarks.length == 0: Label {
        text: @tr("No bookmarks yet.");
    }
    for bookmark in Ui.bookmarks: Rectangle {
        min-height: 36px;
        background: touch.has-hover ? Theme.mantle : transparent;
        HorizontalLayout {
            padding-left: Theme.gap;
            spacing: Theme.pad;
            Text {
                text: bookmark.time-text;
                color: Theme.subtext;
                font-family: Theme.mono;
                font-size: Theme.text-sm;
                vertical-alignment: center;
                min-width: 72px;
            }
            Text {
                text: bookmark.title;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconButton {
                label: @tr("Remove bookmark");
                clicked => {
                    Ui.remove-bookmark(bookmark.time);
                }
                CloseIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        touch := TouchArea {
            clicked => {
                Ui.seek-to(bookmark.time);
            }
        }
    }
}

component NowPlaying inherits VerticalLayout {
    spacing: Theme.pad;
    alignment: start;
    Cover {
        width: 320px;
        height: 320px;
        source: Ui.now-cover;
        has-image: Ui.now-has-cover;
        title: Ui.now-title;
    }
    Heading {
        text: Ui.now-title;
        wrap: word-wrap;
        overflow: clip;
        width: 320px;
    }
    Label {
        text: Ui.now-author;
        font-size: Theme.text-base;
    }
    VerticalLayout {
        spacing: 4px;
        width: 320px;
        Text {
            text: Ui.chapter-title;
            color: Theme.text;
            font-size: Theme.text-base;
            overflow: elide;
        }
        SeekBar {
            label: @tr("Position in chapter");
            value: Ui.chapter-fraction;
            seek(fraction) => {
                Ui.seek-chapter-fraction(fraction);
            }
        }
        HorizontalLayout {
            TimeText {
                text: Ui.chapter-position-text;
                horizontal-stretch: 1;
            }
            TimeText {
                text: Ui.remaining-text;
            }
        }
    }
    Transport { }
    Label {
        text: @tr("Speed");
    }
    Segmented {
        label: @tr("Speed");
        options: Ui.speed-options;
        selected: Ui.speed-index;
        select(index) => {
            Ui.set-speed(index);
        }
    }
    Label {
        text: Ui.sleep-text != "" ? @tr("Sleep timer: {}", Ui.sleep-text) : @tr("Sleep timer");
    }
    Segmented {
        label: @tr("Sleep timer");
        options: Ui.sleep-options;
        selected: Ui.sleep-index;
        select(index) => {
            Ui.set-sleep(index);
        }
    }
}

export component PlayerPage inherits Rectangle {
    HorizontalLayout {
        padding: Theme.pad;
        spacing: 2 * Theme.pad;
        if !Ui.has-media: Label {
            text: @tr("Nothing is playing. Pick a book from the library.");
            font-size: Theme.text-base;
        }
        if Ui.has-media: ScrollView {
            width: 352px;
            content-height: max(self.height, now.preferred-height);
            now := NowPlaying { }
        }
        if Ui.has-media: VerticalLayout {
            spacing: Theme.pad;
            horizontal-stretch: 1;
            Heading {
                text: @tr("Chapters");
                font-size: Theme.text-lg;
            }
            ListView {
                vertical-stretch: 2;
                for chapter in Ui.chapters: ChapterRow {
                    chapter: chapter;
                    activate(start) => {
                        Ui.seek-to(start);
                    }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                content-height: max(self.height, marks.preferred-height);
                marks := BookmarkList {
                    width: parent.width - 16px;
                }
            }
        }
    }
}
