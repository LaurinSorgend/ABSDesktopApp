import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Ui } from "../state.slint";
import { Page } from "../data.slint";
import { Cover } from "../tiles.slint";
import { Sheen } from "../glass.slint";
import { Panel } from "../shell.slint";
import { ChapterRow } from "detail.slint";
import { Button, Dropdown, Heading, IconButton, Label, SeekBar } from "../widgets.slint";
import {
    PlayIcon, PauseIcon, PreviousIcon, NextIcon, RewindIcon, ForwardIcon, CloseIcon, VolumeIcon,
    MutedIcon, FullScreenIcon, ExitFullScreenIcon, MiniPlayerIcon,
} from "../icons.slint";

/// Play and pause drawn on top of each other; the outgoing shape turns away and shrinks
/// while the incoming one turns in.
component PlayPauseIcon inherits Rectangle {
    width: 20px;
    height: 20px;
    PauseIcon {
        color: Theme.on-action;
        opacity: Ui.playing ? 1 : 0;
        transform-rotation: Ui.playing ? 0deg : -90deg;
        transform-scale: Ui.playing ? 100% : 40%;
        animate opacity, transform-rotation, transform-scale { duration: Theme.settle; easing: ease-out-expo; }
    }
    PlayIcon {
        color: Theme.on-action;
        opacity: Ui.playing ? 0 : 1;
        transform-rotation: Ui.playing ? 90deg : 0deg;
        transform-scale: Ui.playing ? 40% : 100%;
        animate opacity, transform-rotation, transform-scale { duration: Theme.settle; easing: ease-out-expo; }
    }
}

/// Previous chapter, skip back, play/pause, skip forward, next chapter.
export component Transport inherits HorizontalLayout {
    /// Smaller buttons without the skip lengths, for the mini player.
    in property <bool> compact;
    in property <length> play-size: compact ? 36px : 48px;
    property <length> button: compact ? 32px : 40px;
    spacing: 4px;
    alignment: center;
    IconButton {
        width: root.button;
        height: root.button;
        label: @tr("Previous chapter");
        clicked => {
            Ui.previous-chapter();
        }
        PreviousIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    IconButton {
        width: root.button;
        height: root.button;
        label: @tr("Skip back {}", Ui.skip-back-text);
        clicked => {
            Ui.skip-back();
        }
        RewindIcon {
            x: (parent.width - self.width) / 2;
            y: root.compact ? (parent.height - self.height) / 2 : 6px;
            width: 18px;
            height: 18px;
        }
        if !root.compact: Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-back-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    play := IconButton {
        label: Ui.playing ? @tr("Pause") : @tr("Play");
        width: root.play-size;
        height: root.play-size;
        rest-color: Theme.action;
        hover-color: Theme.action.mix(Theme.on-action, 0.9);
        press-color: Theme.action.mix(Theme.on-action, 0.8);
        border-radius: Theme.play-button == 1 || (Theme.play-button == 0 && Theme.round-icons) ? self.height / 2
            : Theme.play-button == 2 ? 16px : Theme.radius;
        drop-shadow-offset-y: Theme.play-shadow ? 3px : 0px;
        drop-shadow-blur: Theme.play-shadow ? 10px : 0px;
        drop-shadow-color: Theme.shadow;
        clicked => {
            Ui.toggle-play();
        }
        PlayPauseIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            transform-scale: play.pressed ? 88% : 100%;
            animate transform-scale { duration: Theme.quick; easing: ease-out; }
        }
    }
    IconButton {
        width: root.button;
        height: root.button;
        label: @tr("Skip forward {}", Ui.skip-forward-text);
        clicked => {
            Ui.skip-forward();
        }
        ForwardIcon {
            x: (parent.width - self.width) / 2;
            y: root.compact ? (parent.height - self.height) / 2 : 6px;
            width: 18px;
            height: 18px;
        }
        if !root.compact: Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-forward-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    IconButton {
        width: root.button;
        height: root.button;
        label: @tr("Next chapter");
        clicked => {
            Ui.next-chapter();
        }
        NextIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

component TimeText inherits Text {
    font-family: Theme.mono;
    font-size: Theme.text-sm;
    color: Theme.subtext;
    vertical-alignment: center;
}

/// Book progress with chapter markers.
export component BookProgress inherits HorizontalLayout {
    spacing: Theme.gap;
    TimeText {
        text: Ui.position-text;
        min-width: 64px;
        horizontal-alignment: right;
    }
    SeekBar {
        label: @tr("Position in book");
        value: Ui.position-fraction;
        markers: Ui.chapter-markers;
        horizontal-stretch: 1;
        seek(fraction) => {
            Ui.seek-fraction(fraction);
        }
    }
    TimeText {
        text: Ui.remaining-text;
        min-width: 64px;
    }
}

export component ChapterProgress inherits HorizontalLayout {
    spacing: Theme.gap;
    TimeText {
        text: Ui.chapter-elapsed-text;
        min-width: 64px;
        horizontal-alignment: right;
    }
    SeekBar {
        label: @tr("Position in chapter");
        value: Ui.chapter-fraction;
        horizontal-stretch: 1;
        seek(fraction) => {
            Ui.seek-chapter-fraction(fraction);
        }
    }
    TimeText {
        text: Ui.chapter-remaining-text;
        min-width: 64px;
    }
}

/// Mute button and volume slider.
export component Volume inherits HorizontalLayout {
    height: 40px;
    spacing: 4px;
    alignment: start;
    IconButton {
        label: Ui.muted ? @tr("Unmute") : @tr("Mute");
        clicked => {
            Ui.toggle-mute();
        }
        if !Ui.muted: VolumeIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if Ui.muted: MutedIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    SeekBar {
        label: @tr("Volume");
        width: 96px;
        height: 40px;
        value: Ui.muted ? 0 : Ui.volume / 100;
        scrub(fraction) => {
            Ui.set-volume(fraction * 100);
        }
        seek(fraction) => {
            Ui.set-volume(fraction * 100);
        }
    }
}

/// The mini player and full screen.
export component ViewButtons inherits HorizontalLayout {
    spacing: 4px;
    IconButton {
        label: @tr("Mini player");
        clicked => {
            Ui.set-view(1);
        }
        MiniPlayerIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    IconButton {
        label: Ui.view == 2 ? @tr("Leave full screen") : @tr("Full screen");
        clicked => {
            Ui.set-view(Ui.view == 2 ? 0 : 2);
        }
        if Ui.view != 2: FullScreenIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if Ui.view == 2: ExitFullScreenIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

/// Cover, title and chapter of the loaded item; opens the full player.
component NowPlayingSummary inherits Rectangle {
    accessible-role: button;
    accessible-label: @tr("Open player");
    accessible-action-default => {
        Ui.navigate(Page.player);
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Cover {
            width: 56px;
            height: 56px;
            source: Ui.now-cover;
            has-image: Ui.now-has-cover;
            title: Ui.now-title;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: Ui.now-title;
                color: Theme.text;
                font-weight: 500;
                font-size: Theme.text-sm;
                overflow: elide;
            }
            Label {
                text: Ui.loading-media ? @tr("Loading…") : Ui.chapter-title != "" ? Ui.chapter-title : Ui.now-author;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Ui.navigate(Page.player);
        }
    }
}

/// The bar at the bottom or top while an item is loaded. The controls sit in the middle
/// of the window; the item is on the left, volume and speed on the right.
/// It floats as a panel when the theme says so.
export component PlayerBar inherits Rectangle {
    property <bool> top: Theme.player-position == 1;
    property <length> inner-width: self.width - 2 * Theme.inset;
    property <length> center-width: clamp(inner-width - 2 * 300px, 360px, 720px);
    property <length> side-width: (inner-width - self.center-width) / 2;
    property <bool> arrived;
    init => {
        self.arrived = true;
    }
    height: center.preferred-height + 2 * Theme.gap + Theme.inset;
    opacity: arrived ? 1 : 0;
    animate opacity { duration: Theme.arrive; easing: ease-out-expo; }

    Rectangle {
        x: Theme.inset;
        y: root.top ? Theme.inset : 0px;
        width: root.inner-width;
        height: parent.height - Theme.inset;
        background: Theme.bar;
        border-radius: Theme.floating ? Theme.panel-radius : 0px;
        border-width: Theme.floating ? Theme.border : 0px;
        border-color: Theme.rim;
        drop-shadow-offset-y: Theme.floating ? 8px : Theme.abs ? (root.top ? 4px : -4px) : 0px;
        drop-shadow-blur: Theme.floating || Theme.abs ? Theme.panel-shadow : 0px;
        drop-shadow-color: Theme.shadow;
        if Theme.sheen: Sheen {
            width: parent.width;
            height: parent.height;
            radius: parent.border-radius;
        }

        if !Theme.floating && !Theme.abs: Rectangle {
            y: root.top ? parent.height - 1px : 0px;
            height: 1px;
            background: Theme.catppuccin ? Theme.surface1 : Theme.stroke;
        }

        NowPlayingSummary {
            x: Theme.gap;
            y: (parent.height - 56px) / 2;
            width: root.side-width - 2 * Theme.gap;
            height: 56px;
        }

        center := VerticalLayout {
            x: root.side-width;
            y: Theme.gap;
            width: root.center-width;
            spacing: Ui.progress-mode == 2 ? 6px : 2px;
            padding-bottom: Ui.progress-mode == 2 ? Theme.gap : 0;
            Transport { }
            if Ui.progress-mode != 1: BookProgress { }
            if Ui.progress-mode != 0: ChapterProgress { }
        }

        HorizontalLayout {
            x: root.side-width + root.center-width + Theme.gap;
            y: (parent.height - 40px) / 2;
            width: root.side-width - 2 * Theme.gap;
            height: 40px;
            spacing: Theme.gap;
            alignment: end;
            if root.side-width > 360px: Volume { }
            ViewButtons { }
            Dropdown {
                label: @tr("Speed");
                options: Ui.speed-options;
                selected: Ui.speed-index;
                above: true;
                select(index) => {
                    Ui.set-speed(index);
                }
            }
        }
    }
}

component BookmarkList inherits VerticalLayout {
    spacing: Theme.gap;
    alignment: start;
    HorizontalLayout {
        Heading {
            text: @tr("Bookmarks");
            font-size: Theme.text-lg;
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Add bookmark");
            clicked => {
                Ui.add-bookmark();
            }
        }
    }
    if Ui.bookmarks.length == 0: Label {
        text: @tr("No bookmarks yet.");
    }
    for bookmark in Ui.bookmarks: Rectangle {
        min-height: 36px;
        border-radius: Theme.radius;
        background: !touch.has-hover ? transparent : Theme.catppuccin ? Theme.mantle : Theme.control-hover;
        animate background { duration: Theme.quick; easing: ease-out; }
        HorizontalLayout {
            padding-left: Theme.gap;
            spacing: Theme.pad;
            Text {
                text: bookmark.time-text;
                color: Theme.subtext;
                font-family: Theme.mono;
                font-size: Theme.text-sm;
                vertical-alignment: center;
                min-width: 72px;
            }
            Text {
                text: bookmark.title;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconButton {
                label: @tr("Remove bookmark");
                clicked => {
                    Ui.remove-bookmark(bookmark.time);
                }
                CloseIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        touch := TouchArea {
            clicked => {
                Ui.seek-to(bookmark.time);
            }
        }
    }
}

component NowPlaying inherits VerticalLayout {
    /// Width of the cover and of everything under it.
    in property <length> size: 320px;
    spacing: Theme.pad;
    alignment: start;
    Cover {
        width: root.size;
        height: root.size;
        source: Ui.now-cover;
        has-image: Ui.now-has-cover;
        title: Ui.now-title;
    }
    Heading {
        text: Ui.now-title;
        wrap: word-wrap;
        overflow: clip;
        width: root.size;
    }
    Label {
        text: Ui.now-author;
        font-size: Theme.text-base;
    }
    VerticalLayout {
        spacing: 4px;
        width: root.size;
        Text {
            text: Ui.chapter-title;
            color: Theme.text;
            font-size: Theme.text-base;
            overflow: elide;
        }
        ChapterProgress { }
        Label {
            text: @tr("Book");
        }
        BookProgress { }
    }
    Transport { }
    HorizontalLayout {
        Volume { }
        Rectangle {
            horizontal-stretch: 1;
        }
        ViewButtons { }
    }
    HorizontalLayout {
        spacing: Theme.pad;
        alignment: start;
        VerticalLayout {
            spacing: 4px;
            Label {
                text: @tr("Speed");
            }
            Dropdown {
                label: @tr("Speed");
                options: Ui.speed-options;
                selected: Ui.speed-index;
                select(index) => {
                    Ui.set-speed(index);
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Label {
                text: Ui.sleep-text != "" ? @tr("Sleep timer: {}", Ui.sleep-text) : @tr("Sleep timer");
            }
            Dropdown {
                label: @tr("Sleep timer");
                options: Ui.sleep-options;
                selected: Ui.sleep-index;
                min-width: 140px;
                select(index) => {
                    Ui.set-sleep(index);
                }
            }
        }
    }
}

/// The player as a panel beside the pages, with the cover on top.
export component PlayerPanel inherits Rectangle {
    width: Theme.player-width + 2 * Theme.inset;
    property <bool> arrived;
    init => {
        self.arrived = true;
    }
    opacity: arrived ? 1 : 0;
    animate opacity { duration: Theme.arrive; easing: ease-out-expo; }
    Panel {
        x: Theme.inset;
        y: Theme.inset;
        width: parent.width - 2 * Theme.inset;
        height: parent.height - 2 * Theme.inset;
        background: Theme.bar;
        if !Theme.floating: Rectangle {
            x: Theme.player-position == 2 ? parent.width - 1px : 0px;
            width: 1px;
            background: Theme.abs ? #00000033 : Theme.catppuccin ? Theme.surface1 : Theme.stroke;
        }
        panel-scroll := ScrollView {
            content-height: max(self.height, now.preferred-height + 2 * Theme.pad);
            now := NowPlaying {
                x: Theme.pad;
                y: Theme.pad;
                width: panel-scroll.visible-width - 2 * Theme.pad;
                size: self.width;
            }
        }
    }
}

export component PlayerPage inherits Rectangle {
    /// The cover grows with the window and leaves room for the chapter list.
    property <length> cover-size: clamp(min((self.width - 3 * Theme.pad) * 0.45, self.height - 2 * Theme.pad - 400px), 320px, 640px);
    HorizontalLayout {
        padding: Theme.page-pad;
        spacing: 2 * Theme.pad;
        if !Ui.has-media: Label {
            text: @tr("Nothing is playing. Pick a book from the library.");
            font-size: Theme.text-base;
        }
        if Ui.has-media: ScrollView {
            width: root.cover-size + 32px;
            content-height: max(self.height, now.preferred-height);
            now := NowPlaying {
                width: root.cover-size;
                size: root.cover-size;
            }
        }
        if Ui.has-media: VerticalLayout {
            spacing: Theme.pad;
            horizontal-stretch: 1;
            Heading {
                text: @tr("Chapters");
                font-size: Theme.text-lg;
            }
            ListView {
                vertical-stretch: 2;
                for chapter in Ui.chapters: ChapterRow {
                    chapter: chapter;
                    activate(start) => {
                        Ui.seek-to(start);
                    }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                content-height: max(self.height, marks.preferred-height);
                marks := BookmarkList {
                    width: parent.width - 16px;
                }
            }
        }
    }
}
