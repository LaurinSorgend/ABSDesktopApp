import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Ui } from "../state.slint";
import { Page } from "../data.slint";
import { Cover } from "../tiles.slint";
import { ChapterRow } from "detail.slint";
import { Button, Dropdown, Heading, IconButton, Label, SeekBar } from "../widgets.slint";
import {
    PlayIcon, PauseIcon, PreviousIcon, NextIcon, RewindIcon, ForwardIcon, CloseIcon, VolumeIcon,
    MutedIcon,
} from "../icons.slint";

/// Previous chapter, skip back, play/pause, skip forward, next chapter.
export component Transport inherits HorizontalLayout {
    spacing: 4px;
    alignment: center;
    IconButton {
        label: @tr("Previous chapter");
        clicked => {
            Ui.previous-chapter();
        }
        PreviousIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    IconButton {
        label: @tr("Skip back {}", Ui.skip-back-text);
        clicked => {
            Ui.skip-back();
        }
        RewindIcon {
            x: (parent.width - self.width) / 2;
            y: 6px;
            width: 18px;
            height: 18px;
        }
        Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-back-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    IconButton {
        label: Ui.playing ? @tr("Pause") : @tr("Play");
        width: 48px;
        height: 48px;
        background: Theme.accent;
        clicked => {
            Ui.toggle-play();
        }
        if Ui.playing: PauseIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            color: Theme.on-accent;
        }
        if !Ui.playing: PlayIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            color: Theme.on-accent;
        }
    }
    IconButton {
        label: @tr("Skip forward {}", Ui.skip-forward-text);
        clicked => {
            Ui.skip-forward();
        }
        ForwardIcon {
            x: (parent.width - self.width) / 2;
            y: 6px;
            width: 18px;
            height: 18px;
        }
        Text {
            y: parent.height - 15px;
            width: parent.width;
            horizontal-alignment: center;
            text: Ui.skip-forward-text;
            font-family: Theme.mono;
            font-size: 0.625rem;
            color: Theme.subtext;
        }
    }
    IconButton {
        label: @tr("Next chapter");
        clicked => {
            Ui.next-chapter();
        }
        NextIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

component TimeText inherits Text {
    font-family: Theme.mono;
    font-size: Theme.text-sm;
    color: Theme.subtext;
    vertical-alignment: center;
}

/// Book progress with chapter markers.
component BookProgress inherits HorizontalLayout {
    spacing: Theme.gap;
    TimeText {
        text: Ui.position-text;
        min-width: 64px;
        horizontal-alignment: right;
    }
    SeekBar {
        label: @tr("Position in book");
        value: Ui.position-fraction;
        markers: Ui.chapter-markers;
        horizontal-stretch: 1;
        seek(fraction) => {
            Ui.seek-fraction(fraction);
        }
    }
    TimeText {
        text: Ui.remaining-text;
        min-width: 64px;
    }
}

component ChapterProgress inherits HorizontalLayout {
    spacing: Theme.gap;
    TimeText {
        text: Ui.chapter-elapsed-text;
        min-width: 64px;
        horizontal-alignment: right;
    }
    SeekBar {
        label: @tr("Position in chapter");
        value: Ui.chapter-fraction;
        horizontal-stretch: 1;
        seek(fraction) => {
            Ui.seek-chapter-fraction(fraction);
        }
    }
    TimeText {
        text: Ui.chapter-remaining-text;
        min-width: 64px;
    }
}

/// Mute button and volume slider.
export component Volume inherits HorizontalLayout {
    height: 40px;
    spacing: 4px;
    alignment: start;
    IconButton {
        label: Ui.muted ? @tr("Unmute") : @tr("Mute");
        clicked => {
            Ui.toggle-mute();
        }
        if !Ui.muted: VolumeIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if Ui.muted: MutedIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    SeekBar {
        label: @tr("Volume");
        width: 96px;
        height: 40px;
        value: Ui.muted ? 0 : Ui.volume / 100;
        scrub(fraction) => {
            Ui.set-volume(fraction * 100);
        }
        seek(fraction) => {
            Ui.set-volume(fraction * 100);
        }
    }
}

/// The bar at the bottom while an item is loaded.
/// Cover, title and chapter of the loaded item; opens the full player.
component NowPlayingSummary inherits Rectangle {
    accessible-role: button;
    accessible-label: @tr("Open player");
    accessible-action-default => {
        Ui.navigate(Page.player);
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Cover {
            width: 56px;
            height: 56px;
            source: Ui.now-cover;
            has-image: Ui.now-has-cover;
            title: Ui.now-title;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: Ui.now-title;
                color: Theme.text;
                font-weight: 500;
                font-size: Theme.text-sm;
                overflow: elide;
            }
            Label {
                text: Ui.loading-media ? @tr("Loading…") : Ui.chapter-title != "" ? Ui.chapter-title : Ui.now-author;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Ui.navigate(Page.player);
        }
    }
}

/// The bar at the bottom while an item is loaded. The controls sit in the middle
/// of the window; the item is on the left, volume and speed on the right.
export component PlayerBar inherits Rectangle {
    property <length> center-width: clamp(self.width - 2 * 300px, 360px, 720px);
    property <length> side-width: (self.width - self.center-width) / 2;
    height: center.preferred-height + 2 * Theme.gap;
    background: Theme.mantle;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.surface1;
    }

    NowPlayingSummary {
        x: Theme.gap;
        y: (parent.height - 56px) / 2;
        width: root.side-width - 2 * Theme.gap;
        height: 56px;
    }

    center := VerticalLayout {
        x: root.side-width;
        y: Theme.gap;
        width: root.center-width;
        spacing: 2px;
        Transport { }
        if Ui.progress-mode != 1: BookProgress { }
        if Ui.progress-mode != 0: ChapterProgress { }
    }

    HorizontalLayout {
        x: root.side-width + root.center-width + Theme.gap;
        y: (parent.height - 40px) / 2;
        width: root.side-width - 2 * Theme.gap;
        height: 40px;
        spacing: Theme.gap;
        alignment: end;
        Volume { }
        Dropdown {
            label: @tr("Speed");
            options: Ui.speed-options;
            selected: Ui.speed-index;
            above: true;
            select(index) => {
                Ui.set-speed(index);
            }
        }
    }
}

component BookmarkList inherits VerticalLayout {
    spacing: Theme.gap;
    HorizontalLayout {
        Heading {
            text: @tr("Bookmarks");
            font-size: Theme.text-lg;
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Add bookmark");
            clicked => {
                Ui.add-bookmark();
            }
        }
    }
    if Ui.bookmarks.length == 0: Label {
        text: @tr("No bookmarks yet.");
    }
    for bookmark in Ui.bookmarks: Rectangle {
        min-height: 36px;
        background: touch.has-hover ? Theme.mantle : transparent;
        HorizontalLayout {
            padding-left: Theme.gap;
            spacing: Theme.pad;
            Text {
                text: bookmark.time-text;
                color: Theme.subtext;
                font-family: Theme.mono;
                font-size: Theme.text-sm;
                vertical-alignment: center;
                min-width: 72px;
            }
            Text {
                text: bookmark.title;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconButton {
                label: @tr("Remove bookmark");
                clicked => {
                    Ui.remove-bookmark(bookmark.time);
                }
                CloseIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        touch := TouchArea {
            clicked => {
                Ui.seek-to(bookmark.time);
            }
        }
    }
}

component NowPlaying inherits VerticalLayout {
    spacing: Theme.pad;
    alignment: start;
    Cover {
        width: 320px;
        height: 320px;
        source: Ui.now-cover;
        has-image: Ui.now-has-cover;
        title: Ui.now-title;
    }
    Heading {
        text: Ui.now-title;
        wrap: word-wrap;
        overflow: clip;
        width: 320px;
    }
    Label {
        text: Ui.now-author;
        font-size: Theme.text-base;
    }
    VerticalLayout {
        spacing: 4px;
        width: 320px;
        Text {
            text: Ui.chapter-title;
            color: Theme.text;
            font-size: Theme.text-base;
            overflow: elide;
        }
        ChapterProgress { }
        Label {
            text: @tr("Book");
        }
        BookProgress { }
    }
    Transport { }
    Volume { }
    HorizontalLayout {
        spacing: Theme.pad;
        alignment: start;
        VerticalLayout {
            spacing: 4px;
            Label {
                text: @tr("Speed");
            }
            Dropdown {
                label: @tr("Speed");
                options: Ui.speed-options;
                selected: Ui.speed-index;
                select(index) => {
                    Ui.set-speed(index);
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Label {
                text: Ui.sleep-text != "" ? @tr("Sleep timer: {}", Ui.sleep-text) : @tr("Sleep timer");
            }
            Dropdown {
                label: @tr("Sleep timer");
                options: Ui.sleep-options;
                selected: Ui.sleep-index;
                min-width: 140px;
                select(index) => {
                    Ui.set-sleep(index);
                }
            }
        }
    }
}

export component PlayerPage inherits Rectangle {
    HorizontalLayout {
        padding: Theme.pad;
        spacing: 2 * Theme.pad;
        if !Ui.has-media: Label {
            text: @tr("Nothing is playing. Pick a book from the library.");
            font-size: Theme.text-base;
        }
        if Ui.has-media: ScrollView {
            width: 352px;
            content-height: max(self.height, now.preferred-height);
            now := NowPlaying { }
        }
        if Ui.has-media: VerticalLayout {
            spacing: Theme.pad;
            horizontal-stretch: 1;
            Heading {
                text: @tr("Chapters");
                font-size: Theme.text-lg;
            }
            ListView {
                vertical-stretch: 2;
                for chapter in Ui.chapters: ChapterRow {
                    chapter: chapter;
                    activate(start) => {
                        Ui.seek-to(start);
                    }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                content-height: max(self.height, marks.preferred-height);
                marks := BookmarkList {
                    width: parent.width - 16px;
                }
            }
        }
    }
}
