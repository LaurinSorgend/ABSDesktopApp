// Data passed between Rust and the UI.

export struct TileData {
    id: string,
    title: string,
    author: string,
    cover: image,
    has-cover: bool,
    progress: float,
    finished: bool,
    downloaded: bool,
}

export struct TileRow {
    tiles: [TileData],
}

export struct ShelfData {
    id: string,
    title: string,
    tiles: [TileData],
}

export struct NamedId {
    id: string,
    name: string,
}

export struct GroupData {
    id: string,
    name: string,
    count: string,
}

export struct ChapterData {
    title: string,
    start: float,
    start-text: string,
    length-text: string,
    current: bool,
}

export struct BookmarkData {
    title: string,
    time: float,
    time-text: string,
}

export struct AccountData {
    id: string,
    username: string,
    server: string,
    status: string,
    active: bool,
    needs-login: bool,
    enabled: bool,
}

/// A library on the all-accounts page that can be shown or hidden.
export struct LibraryChoice {
    label: string,
    selected: bool,
}

/// One copy of a work on the work page.
export struct MemberData {
    account-id: string,
    item-id: string,
    title: string,
    /// Account and library.
    place: string,
    narrator: string,
    duration-text: string,
    progress-text: string,
    /// Why it counts as the same book.
    match-text: string,
    can-split: bool,
    can-reset: bool,
}

/// A book that could be merged into the work on the work page.
export struct MatchData {
    account-id: string,
    item-id: string,
    title: string,
    place: string,
}

export struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    author: string,
    narrator: string,
    series: string,
    year: string,
    genres: string,
    duration-text: string,
    progress-text: string,
    progress: float,
    finished: bool,
    description: string,
    cover: image,
    has-cover: bool,
    has-audio: bool,
    has-ebook: bool,
    /// Empty when the book was never opened here or in the web reader.
    reading-text: string,
    chapters-note: string,
    account-id: string,
    can-download: bool,
    /// 0 none, 1 queued, 2 downloading, 3 paused, 4 done, 5 failed.
    download-state: int,
    download-text: string,
    download-fraction: float,
    /// 0 when the item belongs to no work yet.
    work-id: int,
    /// Copies of the same book across accounts, this one included.
    copies: int,
}

/// A row of the downloads list in the settings.
export struct DownloadData {
    account-id: string,
    item-id: string,
    title: string,
    status: string,
    /// As in `DetailData.download-state`.
    state: int,
    fraction: float,
}

export enum Page {
    home,
    library,
    group,
    search,
    detail,
    player,
    settings,
    add-account,
    works,
    work,
}

export enum LibraryView {
    items,
    series,
    authors,
    collections,
}
