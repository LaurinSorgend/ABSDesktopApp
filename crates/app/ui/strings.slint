// Texts that Rust fills in, kept here so that every string goes through @tr.

export global Strings {
    public pure function offline(server: string) -> string {
        @tr("Can't reach {}. Showing what is stored on this computer; retrying every minute.", server)
    }
    public pure function login-required(user: string) -> string {
        @tr("The login for {} has expired. Log in again to sync.", user)
    }
    public pure function sync-failed(message: string) -> string {
        @tr("Sync failed: {}", message)
    }
    public pure function request-failed(message: string) -> string {
        @tr("The server request failed: {}", message)
    }
    public pure function playback-failed(message: string) -> string {
        @tr("Playback could not start: {}", message)
    }
    public pure function reader-failed(message: string) -> string {
        @tr("The book could not be opened: {}", message)
    }
    public pure function player-error(message: string) -> string {
        @tr("Playback error: {}", message)
    }
    public pure function log-in() -> string {
        @tr("Log in")
    }
    public pure function hours-minutes(hours: int, minutes: int) -> string {
        @tr("{} h {} min", hours, minutes)
    }
    public pure function minutes(minutes: int) -> string {
        @tr("{} min", minutes)
    }
    public pure function progress(percent: int, left: string) -> string {
        @tr("{} % · {} left", percent, left)
    }
    public pure function read-percent(percent: int) -> string {
        @tr("{} % read", percent)
    }
    public pure function finished() -> string {
        @tr("Finished")
    }
    public pure function not-started() -> string {
        @tr("Not started")
    }
    public pure function books(count: int) -> string {
        @tr("{n} book" | "{n} books" % count)
    }
    public pure function continue-listening() -> string {
        @tr("Continue listening")
    }
    public pure function recently-added() -> string {
        @tr("Recently added")
    }
    public pure function home-empty() -> string {
        @tr("Nothing here yet. Open a library to pick a book.")
    }
    public pure function loading() -> string {
        @tr("Loading…")
    }
    public pure function needs-connection() -> string {
        @tr("This needs a connection to the server.")
    }
    public pure function no-matches() -> string {
        @tr("No books match.")
    }
    public pure function local-results(count: int) -> string {
        @tr("{n} result on this computer." | "{n} results on this computer." % count)
    }
    public pure function server-results(count: int) -> string {
        @tr("{n} result including the server." | "{n} results including the server." % count)
    }
    public pure function chapters-from-server() -> string {
        @tr("Chapters are loaded from the server.")
    }
    public pure function no-chapters() -> string {
        @tr("This book has no chapters.")
    }
    public pure function status-connecting() -> string {
        @tr("connecting")
    }
    public pure function status-connected() -> string {
        @tr("connected")
    }
    public pure function status-offline() -> string {
        @tr("offline")
    }
    public pure function status-needs-login() -> string {
        @tr("login needed")
    }
    public pure function status-disabled() -> string {
        @tr("turned off")
    }
    public pure function match-same-item() -> string {
        @tr("Same item on the same server")
    }
    public pure function match-asin() -> string {
        @tr("Same ASIN")
    }
    public pure function match-isbn() -> string {
        @tr("Same ISBN")
    }
    public pure function match-title() -> string {
        @tr("Same title, author and length")
    }
    public pure function match-manual() -> string {
        @tr("Put together by you")
    }
    public pure function match-split() -> string {
        @tr("Kept apart by you")
    }
    public pure function plays-from(place: string) -> string {
        @tr("Plays from {}", place)
    }
    public pure function general-choice() -> string {
        @tr("General choice")
    }
    public pure function oldest-account() -> string {
        @tr("Oldest account")
    }
    public pure function no-libraries-chosen() -> string {
        @tr("Choose at least one library.")
    }
    public pure function add-account-title() -> string {
        @tr("Add an account")
    }
    public pure function log-in-again-title() -> string {
        @tr("Log in again")
    }
    public pure function file-credentials() -> string {
        @tr("The system keyring is not available, so logins are kept in a private file in the app's data folder.")
    }
    public pure function bookmark-at(time: string) -> string {
        @tr("Bookmark at {}", time)
    }
    public pure function end-of-chapter() -> string {
        @tr("end of chapter")
    }
    public pure function seconds(count: int) -> string {
        @tr("{} s", count)
    }
    public pure function megabytes(count: int) -> string {
        @tr("{} MB", count)
    }
    public pure function theme-file-sets(keys: string) -> string {
        @tr("The theme file sets {}, so those settings below have no effect.", keys)
    }
    public pure function style-font(name: string) -> string {
        @tr("Theme default ({})", name)
    }
    public pure function system-font() -> string {
        @tr("system font")
    }
    public pure function theme-file-error(message: string) -> string {
        @tr("The theme file has an error and is ignored: {}", message)
    }
    public pure function tray-show() -> string {
        @tr("Show window")
    }
    public pure function tray-toggle() -> string {
        @tr("Play or pause")
    }
    public pure function tray-quit() -> string {
        @tr("Quit")
    }
    public pure function gigabytes(count: string) -> string {
        @tr("{} GB", count)
    }
    public pure function download-queued() -> string {
        @tr("Waiting to download")
    }
    public pure function download-running(percent: int, size: string) -> string {
        @tr("Downloading: {} % of {}", percent, size)
    }
    public pure function download-paused(percent: int) -> string {
        @tr("Paused at {} %", percent)
    }
    public pure function download-done(size: string) -> string {
        @tr("Downloaded · {}", size)
    }
    public pure function download-failed(message: string) -> string {
        @tr("Download failed: {}", message)
    }
    public pure function address-needs-scheme() -> string {
        @tr("A server address starts with http:// or https://.")
    }
    public pure function conflict(title: string, here: string, there: string) -> string {
        @tr("While offline you listened to {} up to {}. Another device is at {}. Which position do you want to keep?", title, here, there)
    }
    public pure function conflict-keep(here: string) -> string {
        @tr("Keep {}", here)
    }
    public pure function conflict-take(there: string) -> string {
        @tr("Use {}", there)
    }
    public pure function sleep-off() -> string {
        @tr("Off")
    }
    public pure function sleep-chapter() -> string {
        @tr("Chapter end")
    }
}
