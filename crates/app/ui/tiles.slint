// Covers, item tiles, the virtualised grid and home shelves.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui } from "state.slint";
import { TileData, TileRow, ShelfData } from "data.slint";
import { Heading } from "widgets.slint";
import { DownloadIcon } from "icons.slint";

/// A framed square with the title and author, for a book without a cover.
component GeneratedCover inherits Rectangle {
    in property <string> title;
    in property <string> author;

    property <float> hue: Ui.cover-hue(root.title);
    property <color> ink: hsv(root.hue, 0.2, 0.93);
    property <length> inset: self.width * 0.04;
    property <bool> has-text: self.width >= 100px;

    background: hsv(root.hue, 0.45, 0.3);

    Rectangle {
        x: root.inset;
        y: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        border-width: max(1px, root.width * 0.006);
        border-color: root.ink;
    }
    if root.has-text: Text {
        x: root.width * 0.1;
        y: root.height * 0.1;
        width: root.width * 0.8;
        height: root.height * 0.62;
        text: root.title;
        color: root.ink;
        font-size: root.width * (root.title.character-count > 40 ? 0.075 : 0.105);
        font-weight: Theme.heading-weight;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if root.has-text: Text {
        x: root.width * 0.1;
        y: root.height * 0.76;
        width: root.width * 0.8;
        height: root.height * 0.12;
        text: root.author;
        color: root.ink;
        font-size: root.width * 0.055;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// A cover image, or a generated one when none arrives. The wait keeps covers
/// that are still loading from flashing the generated one first.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> title;
    in property <string> author;

    property <bool> waited;

    changed title => {
        self.waited = false;
    }
    changed has-image => {
        self.waited = false;
    }

    background: Theme.surface0;
    border-radius: min(Theme.cover-radius, self.width / 6);
    clip: true;

    Timer {
        interval: 300ms;
        running: !root.has-image && !root.waited;
        triggered => {
            root.waited = true;
        }
    }
    if has-image: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        accessible-role: image;
        accessible-label: root.title;
    }
    if !has-image && waited: GeneratedCover {
        width: parent.width;
        height: parent.height;
        title: root.title;
        author: root.author;
        accessible-role: image;
        accessible-label: root.title;
    }
}

export component Tile inherits Rectangle {
    in property <TileData> data;
    callback open(string);

    property <bool> lifted: touch.has-hover || focus.has-focus;
    property <bool> hovered: touch.has-hover || author-touch.has-hover;
    property <bool> can-open-author: !data.finished && data.author != "";

    function hide-peek() {
        if Ui.peek-id == root.data.id {
            Ui.peek-id = "";
        }
    }

    changed hovered => {
        if !self.hovered {
            root.hide-peek();
        }
    }

    Timer {
        interval: 450ms;
        running: root.hovered && Ui.peek-id != root.data.id;
        triggered => {
            Ui.peek-item(root.data.id);
            Ui.peek-x = root.absolute-position.x;
            Ui.peek-y = root.absolute-position.y;
            Ui.peek-id = root.data.id;
        }
    }

    width: Theme.tile-width;
    height: Theme.tile-height;
    accessible-role: button;
    accessible-label: data.title + ", " + data.author;
    accessible-action-default => {
        root.open(root.data.id);
    }

    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: root.width;
            clip: true;
            border-radius: Theme.cover-radius;
            background: Theme.surface0;
            drop-shadow-offset-x: Theme.shelf ? Theme.cover-shadow / 3 : 0px;
            drop-shadow-offset-y: Theme.cover-shadow / 3;
            drop-shadow-blur: Theme.cover-shadow;
            drop-shadow-color: Theme.shadow;
            Cover {
                source: root.data.cover;
                has-image: root.data.has-cover;
                title: root.data.title;
                author: root.data.author;
                border-radius: 0px;
                transform-scale: root.lifted && Theme.cover-zoom ? 106% : 100%;
                animate transform-scale { duration: Theme.arrive; easing: ease-out-expo; }
            }
            Rectangle {
                background: !root.lifted ? transparent
                    : Theme.cover-hover == 2 ? #00000059
                    : Theme.cover-hover == 1 ? Theme.text.with-alpha(0.08) : transparent;
                animate background { duration: Theme.quick; easing: ease-out; }
            }
            Rectangle {
                border-radius: Theme.cover-radius;
                border-width: Theme.cover-hover == 0 ? 2px : 0px;
                border-color: !root.lifted ? Theme.accent.transparentize(1) : Theme.sheen ? #ffffffcc : Theme.accent;
                animate border-color { duration: Theme.quick; easing: ease-out; }
            }
            if root.data.progress > 0 || root.data.finished: Rectangle {
                y: parent.height - 4px;
                x: 0;
                height: 4px;
                width: parent.width * (root.data.finished ? 1 : root.data.progress);
                background: root.data.finished ? Theme.green : Theme.accent;
                animate width { duration: Theme.settle; easing: ease-out-expo; }
            }
            if root.data.downloaded: Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                width: 26px;
                height: 26px;
                border-radius: Theme.round-icons ? 13px : min(Theme.radius, 6px);
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.stroke;
                accessible-role: image;
                accessible-label: @tr("Downloaded");
                DownloadIcon {
                    width: 16px;
                    height: 16px;
                }
            }
        }
        Text {
            text: root.data.title;
            color: root.lifted ? Theme.accent : Theme.text;
            animate color { duration: Theme.quick; easing: ease-out; }
            font-size: Theme.text-sm;
            font-weight: 500;
            overflow: elide;
        }
        author-text := Text {
            text: root.data.finished ? @tr("Finished") : root.data.author;
            color: author-touch.has-hover ? Theme.accent : Theme.subtext;
            font-size: Theme.text-sm;
            overflow: elide;
            animate color { duration: Theme.quick; easing: ease-out; }
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.open(root.data.id);
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.hide-peek();
                root.open(root.data.id);
            }
        }
    }

    author-touch := TouchArea {
        x: author-text.x;
        y: author-text.y;
        width: min(author-text.preferred-width, author-text.width);
        height: author-text.height;
        enabled: root.can-open-author;
        mouse-cursor: pointer;
        clicked => {
            root.hide-peek();
            Ui.open-author(root.data.author);
        }
    }
}

/// The plank the Audiobookshelf style puts under each row of books.
component ShelfPlank inherits Rectangle {
    property <color> top: Theme.colors.shelf;
    property <color> bottom: top.mix(#000000, Theme.dark ? 0.38 : 0.81);
    height: 10px;
    border-radius: 2px;
    background: @linear-gradient(180deg, top 0%, bottom 100%);
    drop-shadow-offset-y: 6px;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.shadow;
}

/// Rows of tiles in a virtualised list. Rust re-flows the rows when `columns` changes
/// and loads covers for the rows reported by `visible-rows`.
export component TileGrid inherits Rectangle {
    in property <[TileRow]> rows;
    out property <int> columns: max(1, floor((self.width - 2 * Theme.page-pad + Theme.pad) / (Theme.tile-width + Theme.pad)));
    callback columns-changed(int);
    callback visible-rows(int, int);
    callback open(string);

    changed columns => {
        root.columns-changed(self.columns);
    }

    function report() {
        root.visible-rows(
            floor(-list.content-y / Theme.row-height),
            ceil((-list.content-y + list.visible-height) / Theme.row-height));
    }

    init => {
        root.columns-changed(self.columns);
    }

    list := ListView {
        changed content-y => {
            Ui.peek-id = "";
            root.report();
        }
        changed visible-height => {
            root.report();
        }
        for row in root.rows: Rectangle {
            height: Theme.row-height;
            HorizontalLayout {
                y: 0;
                height: Theme.tile-height;
                padding-left: Theme.page-pad;
                spacing: Theme.pad;
                alignment: start;
                for tile in row.tiles: Tile {
                    data: tile;
                    open(id) => {
                        root.open(id);
                    }
                }
            }
            if Theme.shelf: ShelfPlank {
                x: Theme.page-pad / 2;
                y: Theme.tile-height + 4px;
                width: parent.width - Theme.page-pad;
            }
        }
    }
}

/// A titled horizontal row of tiles.
export component Shelf inherits VerticalLayout {
    in property <ShelfData> shelf;
    callback open(string);

    spacing: Theme.gap;
    Heading {
        text: root.shelf.title;
        font-size: Theme.text-lg;
    }
    ScrollView {
        height: Theme.tile-height + 16px;
        changed viewport-x => {
            Ui.peek-id = "";
        }
        content-width: max(self.width, inner.preferred-width);
        inner := HorizontalLayout {
            spacing: Theme.pad;
            alignment: start;
            padding-left: Theme.cover-shadow / 2;
            padding-top: Theme.cover-shadow / 3;
            for tile in root.shelf.tiles: Tile {
                data: tile;
                open(id) => {
                    root.open(id);
                }
            }
        }
    }
    if Theme.shelf: ShelfPlank { }
}

component PeekFact inherits HorizontalLayout {
    in property <string> name;
    in property <string> value;
    spacing: Theme.gap;
    visible: value != "";
    Text {
        text: root.name;
        color: Theme.subtext;
        font-size: Theme.text-sm;
        min-width: 80px;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Theme.text-sm;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

/// Facts and the start of the description for the tile under the pointer, beside the tile.
/// It has no touch area, so the pointer keeps hovering the tile underneath.
export component PeekCard inherits Rectangle {
    in property <length> window-width;
    in property <length> window-height;
    property <bool> shown: Ui.peek-id != "" && Ui.peek.id == Ui.peek-id;
    property <bool> fits-right: Ui.peek-x + Theme.tile-width + Theme.gap + self.width <= window-width - Theme.gap;

    width: 320px;
    height: content.preferred-height;
    x: fits-right ? Ui.peek-x + Theme.tile-width + Theme.gap : Ui.peek-x - self.width - Theme.gap;
    y: clamp(Ui.peek-y, Theme.gap, max(Theme.gap, window-height - self.height - Theme.gap));
    visible: self.opacity > 0;
    background: Theme.popup;
    border-width: max(1px, Theme.border);
    border-color: Theme.rim;
    border-radius: Theme.panel-radius;
    drop-shadow-offset-y: 6px;
    drop-shadow-blur: Theme.panel-shadow;
    drop-shadow-color: Theme.shadow;

    states [
        open when root.shown: {
            opacity: 1;
            transform-scale: 100%;
            in {
                animate opacity, transform-scale { duration: Theme.settle; easing: ease-out-expo; }
            }
        }
        closed when !root.shown: {
            opacity: 0;
            transform-scale: Theme.motion ? 97% : 100%;
        }
    ]

    content := VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        Text {
            text: Ui.peek.title;
            color: Theme.text;
            font-size: Theme.text-base;
            font-weight: Theme.strong-weight;
            wrap: word-wrap;
        }
        if Ui.peek.subtitle != "": Text {
            text: Ui.peek.subtitle;
            color: Theme.subtext;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
        VerticalLayout {
            spacing: 4px;
            PeekFact {
                name: @tr("Author");
                value: Ui.peek.author;
            }
            PeekFact {
                name: @tr("Narrator");
                value: Ui.peek.narrator;
            }
            PeekFact {
                name: @tr("Series");
                value: Ui.peek.series;
            }
            PeekFact {
                name: @tr("Length");
                value: Ui.peek.duration-text;
            }
            PeekFact {
                name: @tr("Published");
                value: Ui.peek.year;
            }
            PeekFact {
                name: @tr("Genres");
                value: Ui.peek.genres;
            }
            PeekFact {
                name: @tr("Progress");
                value: Ui.peek.progress-text;
            }
        }
        if Ui.peek.description != "": Text {
            text: Ui.peek.description;
            color: Theme.text;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
    }
}
