// Catppuccin Latte (light) and Mocha (dark), following the system color scheme.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> base: dark ? #1e1e2e : #eff1f5;
    out property <color> mantle: dark ? #181825 : #e6e9ef;
    out property <color> crust: dark ? #11111b : #dce0e8;
    out property <color> surface0: dark ? #313244 : #ccd0da;
    out property <color> surface1: dark ? #45475a : #bcc0cc;
    out property <color> surface2: dark ? #585b70 : #acb0be;
    out property <color> overlay0: dark ? #6c7086 : #9ca0b0;
    out property <color> overlay2: dark ? #9399b2 : #7c7f93;
    out property <color> text: dark ? #cdd6f4 : #4c4f69;
    out property <color> subtext: dark ? #a6adc8 : #5c5f77;
    out property <color> accent: dark ? #89b4fa : #1e66f5;
    out property <color> on-accent: base;
    out property <color> red: dark ? #f38ba8 : #d20f39;
    out property <color> yellow: dark ? #f9e2af : #df8e1d;
    out property <color> green: dark ? #a6e3a1 : #40a02b;

    out property <string> font: "Ronzino";
    out property <string> mono: "Fira Code";

    out property <length> text-sm: 14px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 20px;
    out property <length> text-xl: 24px;

    out property <length> gap: 8px;
    out property <length> pad: 16px;
    out property <length> tile-width: 160px;
    out property <length> tile-height: 230px;
    out property <length> row-height: 246px;
}
