// The keyboard focus ring in the style's shape: an outline, a soft glow or a double ring.

import { Theme } from "theme.slint";

/// Drawn outside its parent, following the parent's corner radius.
export component FocusRing inherits Rectangle {
    in property <length> target-width;
    in property <length> target-height;
    in property <length> target-radius;
    property <length> gap: Theme.focus-kind == 1 ? 0px : 3px;
    property <length> ring: Theme.focus-kind == 1 ? 4px : 2px;
    x: -gap - (Theme.focus-kind == 1 ? ring : 0px);
    y: self.x;
    width: target-width - 2 * self.x;
    height: target-height - 2 * self.x;
    border-radius: target-radius > 0 ? target-radius - self.x : 0px;
    border-width: ring;
    border-color: Theme.focus-kind == 1 ? Theme.accent.with-alpha(0.45) : Theme.focus-kind == 2 ? Theme.text : Theme.accent;

    if Theme.focus-kind == 2: Rectangle {
        x: root.ring;
        y: root.ring;
        width: parent.width - 2 * root.ring;
        height: parent.height - 2 * root.ring;
        border-radius: max(0px, root.border-radius - root.ring);
        border-width: 1px;
        border-color: Theme.base;
    }
}
