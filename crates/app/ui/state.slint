// UI state and actions shared by all pages; Rust fills the properties and handles the callbacks.

import {
    TileData, TileRow, ShelfData, NamedId, GroupData, ChapterData, BookmarkData, AccountData,
    DetailData, DownloadData, Page, LibraryView, LibraryChoice, MemberData, MatchData, ThemeCard,
} from "data.slint";

export global Ui {
    // Navigation
    in-out property <Page> page: Page.home;
    in property <bool> can-go-back;
    /// Bumped by Rust to focus the text field of the current page.
    in property <int> focus-request;
    callback navigate(Page);
    callback back();
    /// Room page headers leave on the right for the floating back button.
    out property <length> back-inset: can-go-back && page != Page.add-account ? 48px : 0;

    // Account and libraries
    in property <[AccountData]> accounts;
    in property <string> account-label;
    in property <[NamedId]> libraries;
    in property <int> library-index: -1;
    in property <bool> syncing;
    callback select-library(int);
    callback sync-now();

    // Offline position conflict, one at a time
    in property <string> conflict-text;
    in property <string> conflict-keep-text;
    in property <string> conflict-take-text;
    callback resolve-conflict(bool);

    // Banner
    in property <string> banner-text;
    in property <int> banner-kind;
    in property <string> banner-action;
    callback banner-act();
    callback banner-dismiss();

    // Grids: "library", "group" and "search"
    callback grid-columns(string, int);
    callback grid-visible(string, int, int);
    callback open-item(string);
    /// Opens the books of the first of these comma-separated authors.
    callback open-author(string);

    // Hover card over a tile: the tile sets id and window position, Rust fills `peek`.
    in-out property <string> peek-id;
    in-out property <length> peek-x;
    in-out property <length> peek-y;
    in property <DetailData> peek;
    callback peek-item(string);

    // Home
    in property <[ShelfData]> shelves;
    in property <string> home-note;

    // Library
    in property <LibraryView> library-view: LibraryView.items;
    in property <int> library-sort;
    in property <bool> library-desc;
    in property <int> library-filter;
    in property <[TileRow]> library-rows;
    in property <string> library-note;
    in property <[GroupData]> groups;
    in property <string> groups-note;
    callback set-library-view(LibraryView);
    callback set-sort(int);
    callback toggle-desc();
    callback set-filter(int);
    callback open-group(string);

    // All accounts: books of the chosen libraries, one tile per work or per copy
    in property <bool> multi-account;
    in property <bool> works-merged: true;
    in property <[LibraryChoice]> works-libraries;
    in property <int> works-sort;
    in property <bool> works-desc;
    in property <int> works-filter;
    in property <[TileRow]> works-rows;
    in property <string> works-note;
    callback set-works-merged(bool);
    callback toggle-works-library(int);
    callback set-works-sort(int);
    callback toggle-works-desc();
    callback set-works-filter(int);
    callback open-works-tile(string);

    // Work: the copies of one book across accounts
    in property <int> work-id;
    in property <string> work-title;
    in property <string> work-author;
    in property <image> work-cover;
    in property <bool> work-has-cover;
    in property <string> work-play-note;
    in property <[MemberData]> work-members;
    in property <[string]> work-account-options;
    in property <int> work-account-index;
    in-out property <string> work-match-text;
    in property <[MatchData]> work-match-results;
    callback open-work(int);
    callback play-work();
    callback set-work-account(int);
    callback open-member(string, string);
    callback split-member(string, string);
    callback reset-member(string, string);
    callback search-work-match(string);
    callback merge-into-work(string, string);

    // Group (series, author, collection)
    in property <string> group-title;
    in property <[TileRow]> group-rows;
    in property <string> group-note;

    // Search
    in-out property <string> search-text;
    in property <[TileRow]> search-rows;
    in property <string> search-note;
    in property <bool> search-server-offered;
    callback search(string);
    callback search-server();

    // Item detail
    in property <DetailData> detail;
    in property <[ChapterData]> detail-chapters;
    callback play-item(string);
    callback play-from(string, float);
    callback set-finished(string, bool);
    callback read-item(string);

    // Downloads, by account and item id
    in property <[DownloadData]> downloads;
    in property <string> download-folder;
    in property <bool> download-folder-custom;
    in property <string> downloads-used-text;
    callback download(string, string);
    callback pause-download(string, string);
    callback resume-download(string, string);
    callback delete-download(string, string);
    callback choose-download-folder();
    callback reset-download-folder();

    // Player
    in property <bool> has-media;
    in property <bool> loading-media;
    in property <bool> playing;
    in property <string> now-id;
    in property <string> now-title;
    in property <string> now-author;
    in property <image> now-cover;
    in property <bool> now-has-cover;
    /// The cover blurred, behind the Glass style while an item is loaded.
    in property <image> now-backdrop;
    in property <bool> now-has-backdrop;
    in property <float> position-fraction;
    in property <float> chapter-fraction;
    in property <string> position-text;
    in property <string> remaining-text;
    in property <string> chapter-title;
    in property <string> chapter-position-text;
    in property <string> chapter-elapsed-text;
    in property <string> chapter-remaining-text;
    /// Chapter starts as fractions of the book, for the book progress bar.
    in property <[float]> chapter-markers;
    /// Player bar progress: 0 book, 1 chapter, 2 both.
    in property <int> progress-mode;
    /// Volume in percent.
    in property <float> volume: 100;
    in property <bool> muted;
    in property <[ChapterData]> chapters;
    in property <[BookmarkData]> bookmarks;
    in property <int> speed-index;
    in property <int> sleep-index;
    in property <string> sleep-text;
    in property <string> skip-back-text;
    in property <string> skip-forward-text;
    /// 0 the whole window, 1 the mini player, 2 the player in full screen.
    in property <int> view;
    /// The mini player stays above other windows.
    in property <bool> mini-on-top;
    callback set-view(int);
    callback toggle-mini-on-top();
    callback toggle-play();
    callback skip-back();
    callback skip-forward();
    callback previous-chapter();
    callback next-chapter();
    callback seek-fraction(float);
    callback seek-chapter-fraction(float);
    callback seek-to(float);
    callback set-speed(int);
    callback set-sleep(int);
    callback set-volume(float);
    callback toggle-mute();
    callback add-bookmark();
    callback remove-bookmark(float);

    // Choices, filled once from Rust
    in property <[string]> speed-options;
    in property <[string]> sleep-options;
    in property <[string]> skip-back-options;
    in property <[string]> skip-forward-options;
    in property <[string]> cache-options;

    // Add account / log in again
    in-out property <string> add-url;
    in-out property <string> add-username;
    in-out property <string> add-password;
    /// 0: username and password, 1: API key.
    in-out property <int> add-method;
    in-out property <string> add-key;
    in property <bool> add-busy;
    in property <string> add-error;
    in property <bool> add-can-cancel;
    in property <string> add-title;
    callback add-account(string, string, string);
    callback add-account-with-key(string, string);

    // Settings
    in property <int> skip-back-index;
    in property <int> skip-forward-index;
    in property <int> default-speed-index;
    in property <int> cache-index;
    in property <int> conflict-index;
    in property <[string]> conflict-options;
    in property <int> remote-check-index;
    in property <[string]> remote-check-options;
    in property <string> cache-used-text;
    in property <bool> close-to-tray;
    in property <string> credentials-note;
    in property <int> theme-mode;
    in property <int> accent-index;
    in property <[color]> accent-swatches;
    in property <[string]> accent-names;
    in property <string> theme-file;
    in property <string> theme-note;
    in property <bool> theme-file-active;
    callback edit-theme-file();
    callback reload-theme();
    callback import-theme();
    callback export-theme();
    callback stop-theme-file();
    /// Bundled and installed themes, and the chosen one's details.
    in property <[ThemeCard]> theme-cards;
    in property <int> theme-index;
    in property <string> theme-description;
    in property <string> theme-version;
    in property <string> theme-creator;
    in property <string> theme-website;
    in property <string> theme-source;
    in property <string> theme-donation;
    /// Installed by the user, so it can be removed.
    in property <bool> theme-installed;
    /// Theme files in the themes folder that could not be read.
    in property <string> theme-errors;
    in property <[string]> palette-options;
    in property <int> light-palette-index;
    in property <int> dark-palette-index;
    callback remove-theme();
    callback open-link(string);
    in property <[string]> font-options;
    in property <[string]> mono-options;
    in property <int> font-index;
    in property <int> mono-index;
    in property <int> font-scale-index;
    in property <int> radius-index;
    in property <int> density-index;
    in property <int> border-index;
    in property <int> focus-index;
    callback set-setting(string, int);
    callback use-account(string);
    callback remove-account(string);
    callback set-account-enabled(string, bool);
    in property <[string]> preferred-account-options;
    in property <int> preferred-account-index;
    in property <bool> mirror-progress;
    callback relogin(string);
    callback add-another-account();

    // Server addresses of the active account, tried from the top
    in property <[string]> server-urls;
    in-out property <string> new-server-url;
    callback add-server-url(string);
    callback remove-server-url(int);
    callback raise-server-url(int);
}
