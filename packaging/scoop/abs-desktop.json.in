{
    "version": "@VERSION@",
    "description": "Desktop client for Audiobookshelf",
    "homepage": "https://github.com/LaurinSorgend/ABSDesktopApp",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/LaurinSorgend/ABSDesktopApp/releases/download/v@VERSION@/abs-desktop-@VERSION@-windows-x64.zip",
            "hash": "@ZIP_SHA256@",
            "extract_dir": "abs-desktop-@VERSION@-windows-x64"
        }
    },
    "bin": "abs-desktop.exe",
    "shortcuts": [
        [
            "abs-desktop.exe",
            "ABS Desktop"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LaurinSorgend/ABSDesktopApp/releases/download/v$version/abs-desktop-$version-windows-x64.zip",
                "extract_dir": "abs-desktop-$version-windows-x64"
            }
        }
    }
}
